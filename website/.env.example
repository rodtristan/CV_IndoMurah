# Backend NestJS API (folder `api/`, global prefix /api/v1) yang dipakai
# untuk login dashboard.
#
# Local dev: default di bawah (localhost) sudah benar.
# Production (Vercel): set NEXT_PUBLIC_API_URL sebagai Environment Variable
# di Vercel dashboard (Project Settings -> Environment Variables), BUKAN
# lewat file ini — NEXT_PUBLIC_* di-bake saat build, jadi harus di-set
# sebelum Vercel menjalankan build:
#   NEXT_PUBLIC_API_URL=https://cvindomurah.up.railway.app/api/v1
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
