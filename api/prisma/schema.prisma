  UpdatedAt       DateTime @updatedAt

  @@map("SalesTargets")
}

// ═══════════════════════════════════════════════════════════════════════════════
// PRODUCT ENHANCEMENTS
// ═══════════════════════════════════════════════════════════════════════════════

// ─── ProductImage ─────────────────────────────────────────────
model ProductImage {
  ID        Int      @id @default(autoincrement())
  ProductID Int
  Url       String   @db.VarChar(500)
  Caption   String?  @db.VarChar(255)
  SortOrder Int      @default(0)
  IsPrimary Boolean  @default(false)
  CreatedAt DateTime @default(now())

  Product Product @relation(fields: [ProductID], references: [ID], onDelete: Cascade)

  @@map("ProductImages")
}

// ─── ProductBarcode ────────────────────────────────────────────
model ProductBarcode {
  ID          Int      @id @default(autoincrement())
  ProductID   Int
  Barcode     String   @db.VarChar(100)
  IsDefault   Boolean  @default(false)
  IsActive    Boolean  @default(true)
  CreatedAt   DateTime @default(now())

  Product Product @relation(fields: [ProductID], references: [ID], onDelete: Cascade)

  @@unique([Barcode])
  @@map("ProductBarcodes")
}

// ─── BrandLogo ────────────────────────────────────────────────
model BrandLogo {
  ID        Int      @id @default(autoincrement())
  BrandID   Int?
  Name      String   @db.VarChar(255)
  LogoUrl   String   @db.VarChar(500)
  Website   String?  @db.VarChar(255)
  SortOrder Int      @default(0)
  IsActive  Boolean  @default(true)
  CreatedAt DateTime @default(now())
  UpdatedAt DateTime @updatedAt

  Brand Brand? @relation(fields: [BrandID], references: [ID])

  @@map("BrandLogos")
}

// ─── NotificationSetting ──────────────────────────────────────
model NotificationSetting {
  ID              Int      @id @default(autoincrement())
  UserID          String
  TypeID          Int
  EmailEnabled    Boolean  @default(false)
  PushEnabled     Boolean  @default(true)
  InAppEnabled    Boolean  @default(true)
  Threshold       Decimal? @db.Decimal(15, 2)
  CreatedAt       DateTime @default(now())
  UpdatedAt       DateTime @updatedAt

  User User              @relation(fields: [UserID], references: [ID], onDelete: Cascade)
  Type  NotificationType @relation(fields: [TypeID], references: [ID])

  @@unique([UserID, TypeID])
  @@map("NotificationSettings")
}

// ─── NotificationGateway (SMS & WhatsApp Gateway Configuration) ─────────────────
model NotificationGateway {
  ID              Int       @id @default(autoincrement())
  Name            String    @db.VarChar(255)
  Type            String    @db.VarChar(50) // 'SMS', 'WHATSAPP'
  GatewayType     String?   @db.VarChar(100) // 'FONNTE', 'WA_BLAST', etc
  ApiUrl          String?   @db.VarChar(500)
  ApiKey          String?   @db.VarChar(500)
  SenderId        String?   @db.VarChar(100) // For SMS
  PhoneNumberId   String?   @db.VarChar(100) // For WhatsApp
  IsDefault       Boolean   @default(false)
  IsActive        Boolean   @default(true)
  CreatedAt       DateTime  @default(now())
  UpdatedAt       DateTime  @updatedAt

  NotificationLogs NotificationLog[]

  @@map("NotificationGateways")
}

// ─── NotificationTemplate ──────────────────────────────────────────────────────
model NotificationTemplate {
  ID              Int       @id @default(autoincrement())
  Code            String    @unique @db.VarChar(50)
  Name            String    @db.VarChar(255)
  Content         String    @db.Text
  Description     String?   @db.VarChar(500)
  Channel         String    @db.VarChar(50) // 'SMS', 'WHATSAPP'
  IsActive        Boolean   @default(true)
  CreatedAt       DateTime  @default(now())
  UpdatedAt       DateTime  @updatedAt

  @@map("NotificationTemplates")
}

// ─── NotificationLog ───────────────────────────────────────────────────────────
model NotificationLog {
  ID              Int       @id @default(autoincrement())
  Channel         String    @db.VarChar(50) // 'SMS', 'WHATSAPP'
  Recipient       String    @db.VarChar(100)
  Message         String    @db.Text
  Status          String    @default("PENDING") @db.VarChar(50) // 'PENDING', 'SENT', 'DELIVERED', 'FAILED'
  MediaUrl        String?   @db.VarChar(500)
  MediaType       String?   @db.VarChar(50)
  ScheduledAt     DateTime?
  SentAt          DateTime?
  DeliveredAt     DateTime?
  ExternalId      String?   @db.VarChar(100)
  ErrorMessage    String?   @db.VarChar(1000)
  GatewayID       Int?
  CreatedByID     String?
  CreatedAt       DateTime  @default(now())
  UpdatedAt       DateTime  @updatedAt

  Gateway  NotificationGateway? @relation(fields: [GatewayID], references: [ID])
  Creator  User?                 @relation(fields: [CreatedByID], references: [ID])

  @@map("NotificationLogs")
}

// ═══════════════════════════════════════════════════════════════════════════════
// HRM - HUMAN RESOURCE MANAGEMENT
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Department ────────────────────────────────────────────────
model Department {
  ID          Int      @id @default(autoincrement())
  Code        String   @unique @db.VarChar(50)
  Name        String   @db.VarChar(255)
  Description String?  @db.VarChar(1000)
  IsActive    Boolean  @default(true)
  CreatedAt   DateTime @default(now())
  UpdatedAt   DateTime @updatedAt

  Employees Employee[]

  @@map("Departments")
}

// ─── Position ─────────────────────────────────────────────────
model Position {
  ID          Int      @id @default(autoincrement())
  Code        String   @unique @db.VarChar(50)
  Name        String   @db.VarChar(255)
  Description String?  @db.VarChar(1000)
  IsActive    Boolean  @default(true)
  CreatedAt   DateTime @default(now())
  UpdatedAt   DateTime @updatedAt

  Employees Employee[]

  @@map("Positions")
}

// ─── Employee ─────────────────────────────────────────────────
model Employee {
  ID            Int            @id @default(autoincrement())
  Code          String         @unique @db.VarChar(50)
  Name          String         @db.VarChar(255)
  DepartmentID  Int?
  PositionID    Int?
  JoinDate      DateTime?
  EndDate       DateTime?
  BirthDate     DateTime?
  Gender        String?        @db.VarChar(20)
  Phone         String?        @db.VarChar(50)
  Email         String?        @db.VarChar(255)
  Address       String?        @db.VarChar(500)
  EmergencyContact String?     @db.VarChar(255)
  EmergencyPhone   String?     @db.VarChar(50)
  BasicSalary   Decimal        @default(0) @db.Decimal(15, 2)
  StatusID      Int            @default(1)
  Notes         String?        @db.VarChar(1000)
  IsActive      Boolean        @default(true)
  CreatedAt     DateTime       @default(now())
  UpdatedAt     DateTime       @updatedAt

  Department Department?   @relation(fields: [DepartmentID], references: [ID])
  Position   Position?      @relation(fields: [PositionID], references: [ID])
  Status     EmployeeStatus @relation(fields: [StatusID], references: [ID])
  Attendances Attendance[]
  Payrolls   Payroll[]
  Loans      Loan[]
  Leaves     Leave[]
  LeaveBalances LeaveBalance[]
  DeviceMappings EmployeeDeviceMapping[]
  ScheduleAssignments ScheduleAssignment[]
  ProgressRecords     ProgressRecord[]

  @@map("Employees")
}

// ─── Attendance ───────────────────────────────────────────────
model Attendance {
  ID               Int              @id @default(autoincrement())
  EmployeeID       Int
  Date             DateTime
  CheckIn          DateTime?
  CheckInLatitude  Decimal?         @db.Decimal(10, 7)
  CheckInLongitude Decimal?         @db.Decimal(10, 7)
  CheckOut         DateTime?
  CheckOutLatitude  Decimal?        @db.Decimal(10, 7)
  CheckOutLongitude Decimal?        @db.Decimal(10, 7)
  StatusID    Int              @default(1)
  Notes      String?          @db.VarChar(1000)
  IsActive   Boolean          @default(true)
  CreatedAt  DateTime         @default(now())
  UpdatedAt  DateTime         @updatedAt

  Employee Employee          @relation(fields: [EmployeeID], references: [ID])
  Status   AttendanceStatus @relation(fields: [StatusID], references: [ID])

  @@unique([EmployeeID, Date])
  @@map("Attendances")
}

// ─── Payroll ───────────────────────────────────────────────────
model Payroll {
  ID           Int      @id @default(autoincrement())
  Code         String   @unique @db.VarChar(50)
  EmployeeID   Int
  Period       String   @db.VarChar(20)
  BasicSalary  Decimal  @db.Decimal(15, 2)
  Allowances   Decimal  @default(0) @db.Decimal(15, 2)
  Deductions   Decimal  @default(0) @db.Decimal(15, 2)
  OvertimePay  Decimal  @default(0) @db.Decimal(15, 2)
  TotalSalary  Decimal  @default(0) @db.Decimal(15, 2)
  PaymentDate  DateTime?
  Notes        String?  @db.VarChar(1000)
  IsPaid       Boolean  @default(false)
  IsActive     Boolean  @default(true)
  CreatedAt    DateTime @default(now())
  UpdatedAt    DateTime @updatedAt

  Employee Employee @relation(fields: [EmployeeID], references: [ID])

  @@map("Payrolls")
}

// ─── Loan / Pinjaman ──────────────────────────────────────────
model Loan {
  ID               Int        @id @default(autoincrement())
  Code             String     @unique @db.VarChar(50)
  EmployeeID       Int
  LoanTypeID       Int
  PrincipalAmount  Decimal    @db.Decimal(15, 2)
  InterestRate     Decimal    @default(0) @db.Decimal(5, 2)
  TenorMonths      Int        @default(1)
  InstallmentAmount Decimal   @db.Decimal(15, 2)
  TotalAmount      Decimal    @db.Decimal(15, 2)
  RemainingAmount  Decimal    @db.Decimal(15, 2)
  StartDate        DateTime?
  StatusID         Int        @default(1)
  Notes            String?    @db.VarChar(1000)
  IsActive         Boolean    @default(true)
  CreatedAt        DateTime   @default(now())
  UpdatedAt        DateTime   @updatedAt

  Employee Employee     @relation(fields: [EmployeeID], references: [ID])
  LoanType LoanType      @relation(fields: [LoanTypeID], references: [ID])
  Status   LoanStatus    @relation(fields: [StatusID], references: [ID])
  Installments LoanInstallment[]

  @@map("Loans")
}

// ─── LoanInstallment ─────────────────────────────────────────
model LoanInstallment {
  ID            Int      @id @default(autoincrement())
  LoanID        Int
  Period        String   @db.VarChar(20)
  Amount        Decimal  @db.Decimal(15, 2)
  Principal     Decimal  @db.Decimal(15, 2)
  Interest      Decimal  @db.Decimal(15, 2)
  RemainingBefore Decimal @db.Decimal(15, 2)
  RemainingAfter  Decimal @db.Decimal(15, 2)
  PaymentDate   DateTime?
  Status        String   @default("UNPAID") @db.VarChar(20)
  IsActive      Boolean  @default(true)
  CreatedAt     DateTime @default(now())

  Loan Loan @relation(fields: [LoanID], references: [ID])

  @@map("LoanInstallments")
}

// ═══════════════════════════════════════════════════════════════════════════════
// LEAVE MANAGEMENT (Cuti/Izin)
// ═══════════════════════════════════════════════════════════════════════════════

model Leave {
  ID            Int         @id @default(autoincrement())
  Code          String      @unique @db.VarChar(50)
  EmployeeID    Int
  TypeID        Int
  StartDate     DateTime
  EndDate       DateTime
  TotalDays     Int         @default(1)
  Reason        String?     @db.VarChar(1000)
  StatusID      Int         @default(1)
  ApprovedByID  String?
  ApprovedAt    DateTime?
  RejectedReason String?    @db.VarChar(500)
  Notes         String?     @db.VarChar(1000)
  IsActive      Boolean     @default(true)
  CreatedAt     DateTime    @default(now())
  UpdatedAt     DateTime    @updatedAt

  Employee Employee      @relation(fields: [EmployeeID], references: [ID])
  Type     LeaveType     @relation(fields: [TypeID], references: [ID])
  Approver User?        @relation(fields: [ApprovedByID], references: [ID])
  Status   LeaveStatus   @relation(fields: [StatusID], references: [ID])

  @@map("Leaves")
}

// ─── LeaveBalance (Sisa Cuti Karyawan) ─────────────────────
model LeaveBalance {
  ID          Int       @id @default(autoincrement())
  EmployeeID  Int
  Year        Int
  TypeID      Int
  TotalDays   Int       @default(0)
  UsedDays    Int       @default(0)
  RemainingDays Int      @default(0)
  IsActive    Boolean   @default(true)
  CreatedAt   DateTime  @default(now())
  UpdatedAt   DateTime  @updatedAt

  Employee Employee  @relation(fields: [EmployeeID], references: [ID])
  Type     LeaveType @relation(fields: [TypeID], references: [ID])

  @@unique([EmployeeID, Year, TypeID])
  @@map("LeaveBalances")
}

// ═══════════════════════════════════════════════════════════════════════════════
// NOTIFICATION
// ═══════════════════════════════════════════════════════════════════════════════

model Notification {
  ID        Int                @id @default(autoincrement())
  UserID    String?
  Title     String            @db.VarChar(255)
  Message   String            @db.VarChar(1000)
  TypeID    Int                @default(1)
  IsRead    Boolean           @default(false)
  ReferenceType String?       @db.VarChar(100)
  ReferenceID   Int?
  IsActive  Boolean           @default(true)
  CreatedAt DateTime          @default(now())

  User User?              @relation(fields: [UserID], references: [ID])
  Type  NotificationType @relation(fields: [TypeID], references: [ID])

  @@map("Notifications")
}

