// ─── QCCheckpoint ───────────────────────────────────────────────────────────
model QCCheckpoint {
  ID           Int       @id @default(autoincrement())
  Name         String    @db.VarChar(255)
  QCCategoryID Int
  Description  String?   @db.VarChar(1000)
  IsRequired   Boolean   @default(true)
  PassCriteria String?   @db.VarChar(500)
  SortOrder    Int       @default(0)
  IsActive     Boolean   @default(true)
  CreatedAt    DateTime  @default(now())
  UpdatedAt    DateTime  @updatedAt

  QCCategory   QCCategory    @relation(fields: [QCCategoryID], references: [ID], onDelete: Cascade)
  Results      QCCheckResult[]

  @@map("QCCheckpoints")
}

// ─── QCCheck ────────────────────────────────────────────────────────────────
model QCCheck {
  ID               Int       @id @default(autoincrement())
  Code             String    @unique @db.VarChar(50)
  QCCategoryID     Int
  ReferenceType   String    @db.VarChar(100)
  ReferenceID     Int
  Date            DateTime  @default(now())
  InspectorName   String?   @db.VarChar(255)
  Result          String    @default("PENDING") @db.VarChar(50)
  Notes           String?   @db.VarChar(1000)
  CreatedByID     String?
  CreatedAt       DateTime  @default(now())
  UpdatedAt       DateTime  @updatedAt

  QCCategory      QCCategory     @relation(fields: [QCCategoryID], references: [ID])
  Creator         User?         @relation(fields: [CreatedByID], references: [ID])
  Results         QCCheckResult[]

  @@map("QCChecks")
}

// ─── QCCheckResult ──────────────────────────────────────────────────────────
model QCCheckResult {
  ID             Int      @id @default(autoincrement())
  QCCheckID      Int
  QCCheckpointID Int
  Result         String   @db.VarChar(50)
  ActualValue    String?  @db.VarChar(255)
  Notes          String?  @db.VarChar(1000)
  CreatedAt      DateTime @default(now())

  QCCheck        QCCheck      @relation(fields: [QCCheckID], references: [ID], onDelete: Cascade)
  QCCheckpoint   QCCheckpoint @relation(fields: [QCCheckpointID], references: [ID])

  @@map("QCCheckResults")
}

// ═══════════════════════════════════════════════════════════════════════════════
// WORK ORDER MODULE
// ═══════════════════════════════════════════════════════════════════════════════

// ─── WorkOrder ──────────────────────────────────────────────────────────────
model WorkOrder {
  ID                    Int       @id @default(autoincrement())
  WorkOrderNumber       String    @unique @db.VarChar(50)
  WorkOrderDate         DateTime  @default(now())
  DueDate               DateTime?
  ProductionID          Int?
  WarehouseID           Int?
  AssignedToID          Int?
  StatusID             Int       @default(1)
  Priority              String    @default("NORMAL") @db.VarChar(20)
  EstimatedCost         Decimal   @default(0) @db.Decimal(15, 2)
  Notes                 String?   @db.VarChar(1000)
  ScheduledStartDate    DateTime?
  ScheduledEndDate      DateTime?
  CancelledByID        String?
  CancelledAt           DateTime?
  CreatedByID           String?
  CreatedAt             DateTime  @default(now())
  UpdatedAt             DateTime  @updatedAt

  Production            Production?  @relation(fields: [ProductionID], references: [ID])
  Warehouse             Warehouse?   @relation(fields: [WarehouseID], references: [ID])
  Status                TransactionStatus @relation(fields: [StatusID], references: [ID])
  Items                 WorkOrderItem[]
  ProgressRecords       ProgressRecord[]
  MaterialAllocations   MaterialAllocation[]
  Schedules             WorkOrderSchedule[]

  @@map("WorkOrders")
}

// ─── WorkOrderItem ──────────────────────────────────────────────────────────
model WorkOrderItem {
  ID              Int      @id @default(autoincrement())
  WorkOrderID     Int
  ProductID       Int
  ProductName     String   @db.VarChar(255)
  Quantity        Decimal  @db.Decimal(15, 3)
  UnitID          Int?
  UnitPrice       Decimal  @default(0) @db.Decimal(15, 2)
  Subtotal        Decimal  @default(0) @db.Decimal(15, 2)
  BOMID           Int?
  SortOrder       Int      @default(0)
  CreatedAt       DateTime @default(now())

  WorkOrder       WorkOrder @relation(fields: [WorkOrderID], references: [ID], onDelete: Cascade)
  Product         Product?   @relation(fields: [ProductID], references: [ID])
  Unit            Unit?     @relation(fields: [UnitID], references: [ID])
  BOM             BOM?      @relation(fields: [BOMID], references: [ID])

  @@map("WorkOrderItems")
}

// ─── ProgressRecord ──────────────────────────────────────────────────────────
model ProgressRecord {
  ID                 Int       @id @default(autoincrement())
  WorkOrderID        Int
  ProductID          Int?
  CompletedQuantity  Decimal   @db.Decimal(15, 3)
  WorkStationID      Int?
  EmployeeID         Int?
  Notes              String?   @db.VarChar(1000)
  RecordedByID       String?
  CreatedAt          DateTime  @default(now())

  WorkOrder          WorkOrder    @relation(fields: [WorkOrderID], references: [ID], onDelete: Cascade)
  Product            Product?     @relation(fields: [ProductID], references: [ID])
  WorkStation        WorkStation? @relation(fields: [WorkStationID], references: [ID])
  Employee           Employee?    @relation(fields: [EmployeeID], references: [ID])

  @@map("ProgressRecords")
}

// ─── MaterialAllocation ──────────────────────────────────────────────────────
model MaterialAllocation {
  ID                Int      @id @default(autoincrement())
  WorkOrderID       Int
  ProductID         Int
  AllocatedQuantity Decimal  @db.Decimal(15, 3)
  UsedQuantity      Decimal  @default(0) @db.Decimal(15, 3)
  Status            String   @default("ALLOCATED") @db.VarChar(20)
  CreatedAt         DateTime @default(now())
  UpdatedAt         DateTime @updatedAt

  WorkOrder         WorkOrder @relation(fields: [WorkOrderID], references: [ID], onDelete: Cascade)
  Product           Product    @relation(fields: [ProductID], references: [ID])

  @@map("MaterialAllocations")
}

// ─── WorkOrderSchedule ───────────────────────────────────────────────────────
model WorkOrderSchedule {
  ID              Int      @id @default(autoincrement())
  WorkOrderID     Int
  ResourceType    String   @db.VarChar(50)
  ResourceID      Int
  AllocatedHours  Decimal  @default(0) @db.Decimal(5, 2)
  CreatedAt       DateTime @default(now())

  WorkOrder       WorkOrder @relation(fields: [WorkOrderID], references: [ID], onDelete: Cascade)

  @@map("WorkOrderSchedules")
}

// ─── WorkStation ────────────────────────────────────────────────────────────
model WorkStation {
  ID           Int       @id @default(autoincrement())
  Code         String    @unique @db.VarChar(50)
  Name         String    @db.VarChar(255)
  Description  String?   @db.VarChar(1000)
  Capacity     Int       @default(1)
  WarehouseID  Int?
  Capabilities String?  @db.VarChar(500)
  IsActive     Boolean   @default(true)
  CreatedAt    DateTime  @default(now())
  UpdatedAt    DateTime  @updatedAt

  Warehouse    Warehouse?        @relation(fields: [WarehouseID], references: [ID])
  ProgressRecords ProgressRecord[]

  @@map("WorkStations")
}

// ═══════════════════════════════════════════════════════════════════════════════
// ASSEMBLY MODULE
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Assembly ───────────────────────────────────────────────────────────────
model Assembly {
  ID                   Int       @id @default(autoincrement())
  AssemblyNumber       String    @unique @db.VarChar(50)
  AssemblyDate         DateTime  @default(now())
  WarehouseID          Int?
  Description          String?   @db.VarChar(1000)
  ReferenceNumber      String?   @db.VarChar(100)
  TotalComponentCost   Decimal   @default(0) @db.Decimal(15, 2)
  StatusID             Int       @default(1)
  Notes                String?   @db.VarChar(1000)
  BOMID                Int?
  CreatedByID          String?
  CreatedAt            DateTime  @default(now())
  UpdatedAt            DateTime  @updatedAt

  Warehouse            Warehouse?          @relation(fields: [WarehouseID], references: [ID])
  Status               TransactionStatus    @relation(fields: [StatusID], references: [ID])
  BOM                  BOM?                @relation(fields: [BOMID], references: [ID])
  Components           AssemblyComponent[]

  @@map("Assemblies")
}

// ─── AssemblyComponent ───────────────────────────────────────────────────────
model AssemblyComponent {
  ID           Int      @id @default(autoincrement())
  AssemblyID   Int
  ProductID    Int
  ProductName  String   @db.VarChar(255)
  Quantity     Decimal  @db.Decimal(15, 3)
  UnitID       Int?
  UnitPrice    Decimal  @default(0) @db.Decimal(15, 2)
  Subtotal     Decimal  @default(0) @db.Decimal(15, 2)
  SortOrder    Int      @default(0)
  CreatedAt    DateTime @default(now())

  Assembly     Assembly @relation(fields: [AssemblyID], references: [ID], onDelete: Cascade)
  Product      Product? @relation(fields: [ProductID], references: [ID])
  Unit         Unit?    @relation(fields: [UnitID], references: [ID])

  @@map("AssemblyComponents")
}

// ─── BOM (Bill of Materials) ─────────────────────────────────────────────────
model BOM {
  ID               Int       @id @default(autoincrement())
  Code             String    @unique @db.VarChar(50)
  Name             String    @db.VarChar(255)
  ProductID        Int?
  QuantityProduced Decimal   @default(1) @db.Decimal(15, 3)
  WarehouseID      Int?
  Description      String?   @db.VarChar(1000)
  TotalCost        Decimal   @default(0) @db.Decimal(15, 2)
  UnitCost         Decimal   @default(0) @db.Decimal(15, 2)
  DefaultCost      Decimal?  @db.Decimal(15, 2)
  IsActive         Boolean   @default(true)
  CreatedByID      String?
  CreatedAt        DateTime  @default(now())
  UpdatedAt        DateTime  @updatedAt

  Product          Product?      @relation(fields: [ProductID], references: [ID])
  Warehouse        Warehouse?     @relation(fields: [WarehouseID], references: [ID])
  BOMItems         BOMItem[]
  WorkOrderItems     WorkOrderItem[]
  Assemblies       Assembly[]

  @@map("BOMs")
}

// ─── BOMItem ─────────────────────────────────────────────────────────────────
model BOMItem {
  ID             Int      @id @default(autoincrement())
  BOMID          Int
  ProductID      Int
  ProductName    String   @db.VarChar(255)
  Quantity       Decimal  @db.Decimal(15, 3)
  UnitID         Int?
  UnitPrice      Decimal  @default(0) @db.Decimal(15, 2)
  Subtotal       Decimal  @default(0) @db.Decimal(15, 2)
  WastePercent   Decimal  @default(0) @db.Decimal(5, 2)
  SortOrder      Int      @default(0)
  CreatedAt      DateTime @default(now())

  BOM            BOM      @relation(fields: [BOMID], references: [ID], onDelete: Cascade)
  Product        Product? @relation(fields: [ProductID], references: [ID])
  Unit           Unit?    @relation(fields: [UnitID], references: [ID])

  @@map("BOMItems")
}

// ─── ProductionRecipe (Recipe Produksi) ─────────────────────────────────────
model ProductionRecipe {
  ID          Int       @id @default(autoincrement())
  ProductID   Int
  Name        String    @db.VarChar(255)
  Description String?   @db.VarChar(1000)
  IsActive    Boolean   @default(true)
  CreatedByID String?
  CreatedAt   DateTime  @default(now())
  UpdatedAt   DateTime  @updatedAt

  Product Product             @relation(fields: [ProductID], references: [ID])
  Items  ProductionRecipeItem[]

  @@unique([ProductID])
  @@map("ProductionRecipes")
}

// ─── ProductionRecipeItem (Item Recipe Produksi) ────────────────────────────
model ProductionRecipeItem {
  ID                   Int      @id @default(autoincrement())
  ProductionRecipeID   Int
  ProductID           Int
  WarehouseID         Int?
  UnitID              Int?
  Quantity            Decimal  @db.Decimal(15, 3)
  Price               Decimal  @default(0) @db.Decimal(15, 2)
  IsActive            Boolean  @default(true)
  CreatedAt           DateTime @default(now())

  ProductionRecipe ProductionRecipe @relation(fields: [ProductionRecipeID], references: [ID], onDelete: Cascade)
  Product        Product?        @relation(fields: [ProductID], references: [ID])
  Warehouse      Warehouse?      @relation(fields: [WarehouseID], references: [ID])
  Unit           Unit?           @relation(fields: [UnitID], references: [ID])

  @@map("ProductionRecipeItems")
}

// ─── ProductionRequest (Permintaan Produksi) ────────────────────────────────
model ProductionRequest {
  ID              Int       @id @default(autoincrement())
  RequestNumber   String    @unique @db.VarChar(50)
  RequestDate     DateTime  @default(now())
  ProductID       Int?
  SupplierID      Int?
  WarehouseID     Int?
  Status          String    @default("PENDING") @db.VarChar(50)
  Notes           String?   @db.VarChar(1000)
  CreatedBy       String?
  CreatedAt       DateTime  @default(now())
  UpdatedAt       DateTime  @updatedAt

  Supplier Supplier?             @relation(fields: [SupplierID], references: [ID])
  Warehouse Warehouse?          @relation(fields: [WarehouseID], references: [ID])
  Product   Product?           @relation(fields: [ProductID], references: [ID])
  Items    ProductionRequestItem[]

  @@map("ProductionRequests")
}

// ─── ProductionRequestItem (Item Permintaan Produksi) ───────────────────────
model ProductionRequestItem {
  ID                   Int       @id @default(autoincrement())
  ProductionRequestID  Int
  ProductID           Int
  WarehouseID         Int?
  UnitID              Int?
  Quantity            Decimal   @db.Decimal(15, 3)
  Price               Decimal   @default(0) @db.Decimal(15, 2)
  CreatedAt           DateTime  @default(now())

  ProductionRequest ProductionRequest @relation(fields: [ProductionRequestID], references: [ID], onDelete: Cascade)
  Product        Product?        @relation(fields: [ProductID], references: [ID])
  Warehouse      Warehouse?      @relation(fields: [WarehouseID], references: [ID])
  Unit           Unit?           @relation(fields: [UnitID], references: [ID])

  @@map("ProductionRequestItems")
}

// ─── ProductionSchedule (Jadwal Produksi) ───────────────────────────────────
model ProductionSchedule {
  ID                      Int       @id @default(autoincrement())
  ProductionScheduleNumber String    @unique @db.VarChar(50)
  ProductID               Int
  WarehouseID             Int?
  ScheduledDate           DateTime
  Quantity                Decimal   @db.Decimal(15, 3)
  Status                  String    @default("SCHEDULED") @db.VarChar(50)
  Notes                   String?   @db.VarChar(1000)
  CreatedBy               String?
  CreatedAt               DateTime  @default(now())
  UpdatedAt               DateTime  @updatedAt

  Product   Product   @relation(fields: [ProductID], references: [ID])
  Warehouse Warehouse? @relation(fields: [WarehouseID], references: [ID])

  @@map("ProductionSchedules")
}

// ═══════════════════════════════════════════════════════════════════════════════
// JOURNAL ENHANCEMENTS
// ═══════════════════════════════════════════════════════════════════════════════

// ─── JournalEntryLine ────────────────────────────────────────────────────────
model JournalEntryLine {
  ID              Int      @id @default(autoincrement())
  JournalEntryID  Int
  AccountID       Int
  DebitCredit    String?  @db.VarChar(10) // 'DEBIT' or 'KREDIT'
  Amount          Decimal  @default(0) @db.Decimal(15, 2)
  Debit           Decimal  @default(0) @db.Decimal(15, 2)
  Credit          Decimal  @default(0) @db.Decimal(15, 2)
  Description     String?  @db.VarChar(500)
  LineNumber      Int      @default(1)
  CreatedByID     String?
  CreatedAt       DateTime @default(now())

  JournalEntry JournalEntry @relation(fields: [JournalEntryID], references: [ID], onDelete: Cascade)
  Account     Account     @relation(fields: [AccountID], references: [ID])
  Creator     User?       @relation(fields: [CreatedByID], references: [ID])

  @@map("JournalEntryLines")
}

// ─── ClosingEntry ─────────────────────────────────────────────────────────────
model ClosingEntry {
  ID              Int       @id @default(autoincrement())
  PeriodEndDate   DateTime
  JournalEntryID  Int
  TotalIncome    Decimal   @default(0) @db.Decimal(15, 2)
  TotalExpense   Decimal   @default(0) @db.Decimal(15, 2)
  NetIncome      Decimal   @default(0) @db.Decimal(15, 2)
  CreatedByID     String
  CreatedAt       DateTime  @default(now())

  JournalEntry JournalEntry @relation(fields: [JournalEntryID], references: [ID])
  Creator     User        @relation(fields: [CreatedByID], references: [ID])

  @@map("ClosingEntries")
}

// ═══════════════════════════════════════════════════════════════════════════════
// ACCOUNTING ENHANCEMENTS
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Account Fields for Enhanced Accounting ──────────────────────────────
model AccountExtension {
  ID             Int      @id @default(autoincrement())
  AccountID      Int      @unique
  TaxRate        Decimal? @db.Decimal(5, 2)
  DepreciationMethod String? @db.VarChar(50)
  UsefulLife     Int?
  SalvageValue   Decimal? @db.Decimal(15, 2)
  CurrentDebit   Decimal  @default(0) @db.Decimal(15, 2)
  CurrentCredit  Decimal  @default(0) @db.Decimal(15, 2)
  CurrentBalance Decimal  @default(0) @db.Decimal(15, 2)
  CreatedAt     DateTime @default(now())
  UpdatedAt     DateTime @updatedAt

  Account Account @relation(fields: [AccountID], references: [ID], onDelete: Cascade)

  @@map("AccountExtensions")
}

// ═══════════════════════════════════════════════════════════════════════════════
// QUALITY CONTROL ENHANCEMENTS
// ═══════════════════════════════════════════════════════════════════════════════

// ─── QCInspection ──────────────────────────────────────────────────────────
model QCInspection {
  ID                Int               @id @default(autoincrement())
  InspectionNumber  String            @unique @db.VarChar(50)
  InspectionType    String            @db.VarChar(50)
  InspectionDate    DateTime          @default(now())
  SupplierID        Int?
  ProductionID     Int?
  WarehouseID      Int?
  ReferenceNumber  String?            @db.VarChar(100)
  StatusID         Int               @default(1)
  OverallResult    String?           @db.VarChar(50)
  TotalInspected   Decimal?          @db.Decimal(15, 3)
  TotalPassed      Decimal?          @db.Decimal(15, 3)
  TotalRejected    Decimal?          @db.Decimal(15, 3)
  Notes            String?            @db.VarChar(1000)
  InspectedByID   String?
  InspectedAt     DateTime?
  CreatedByID      String
  CreatedAt        DateTime          @default(now())
  UpdatedAt        DateTime          @updatedAt

  Supplier      Supplier?          @relation(fields: [SupplierID], references: [ID])
  Production   Production?        @relation(fields: [ProductionID], references: [ID])
  Warehouse    Warehouse?         @relation(fields: [WarehouseID], references: [ID])
  Status      TransactionStatus   @relation(fields: [StatusID], references: [ID])
  Inspector   User?              @relation("QCInspectionsInspectedBy", fields: [InspectedByID], references: [ID])
  Creator     User               @relation("InspectionCreator", fields: [CreatedByID], references: [ID])

  Items QCInspectionItem[]

  @@map("QCInspections")
}

// ─── QCInspectionItem ────────────────────────────────────────────────────────
model QCInspectionItem {
  ID                Int       @id @default(autoincrement())
  QCInspectionID    Int
  ProductID         Int
  BatchNumber      String?   @db.VarChar(100)
  Quantity         Decimal   @db.Decimal(15, 3)
  UnitID           Int?
  InspectedQuantity Decimal?  @db.Decimal(15, 3)
  PassedQuantity   Decimal?  @db.Decimal(15, 3)
  RejectedQuantity Decimal?  @db.Decimal(15, 3)
  Result           String?   @db.VarChar(50)
  RejectionReason String?   @db.VarChar(500)
  Notes            String?   @db.VarChar(1000)
  InspectedByID   String?
  InspectedAt     DateTime?
  CreatedAt        DateTime  @default(now())

  QCInspection QCInspection @relation(fields: [QCInspectionID], references: [ID], onDelete: Cascade)
  Product      Product      @relation(fields: [ProductID], references: [ID])
  Unit         Unit?       @relation(fields: [UnitID], references: [ID])
  Inspector    User?       @relation("QCInspectionItemsInspectedBy", fields: [InspectedByID], references: [ID])

  @@map("QCInspectionItems")
}

// ─── QCStandard ────────────────────────────────────────────────────────────────
model QCStandard {
  ID                      Int      @id @default(autoincrement())
  ProductID               Int
  InspectionType          String   @db.VarChar(50)
  SampleSize              Int      @default(1)
  AQL                     Decimal  @default(0) @db.Decimal(5, 2)
  MinimumPassingScore      Decimal  @default(0) @db.Decimal(5, 2)
  IsActive                Boolean  @default(true)
  CreatedAt               DateTime @default(now())
  UpdatedAt               DateTime @updatedAt

  Product    Product          @relation(fields: [ProductID], references: [ID])
  Checkpoints QCStandardCheckpoint[]

  @@unique([ProductID, InspectionType])
  @@map("QCStandards")
}

// ─── QCStandardCheckpoint ────────────────────────────────────────────────────
model QCStandardCheckpoint {
  ID              Int      @id @default(autoincrement())
  QCStandardID    Int
  Name            String   @db.VarChar(255)
  Description     String?  @db.VarChar(1000)
  IsMandatory     Boolean  @default(true)
  Weight          Int      @default(1)
  SortOrder       Int      @default(0)
  IsActive        Boolean  @default(true)
  CreatedAt       DateTime @default(now())

  QCStandard QCStandard @relation(fields: [QCStandardID], references: [ID], onDelete: Cascade)

  @@map("QCStandardCheckpoints")
}

// ─── DefectReport ─────────────────────────────────────────────────────────────
model DefectReport {
  ID               Int       @id @default(autoincrement())
  DefectNumber     String    @unique @db.VarChar(50)
  ProductID        Int
  Quantity         Decimal   @db.Decimal(15, 3)
  DefectType      String    @db.VarChar(100)
  Severity        String    @default("MEDIUM") @db.VarChar(20)
  ProductionID    Int?
  SaleID           Int?
  Description     String?   @db.VarChar(1000)
  RootCause        String?   @db.VarChar(1000)
  CorrectiveAction String?   @db.VarChar(1000)
  Status          String    @default("OPEN") @db.VarChar(50)
  ReportedByID     String
  ResolvedByID    String?
  ResolvedAt      DateTime?
  CreatedAt        DateTime  @default(now())
  UpdatedAt        DateTime  @updatedAt

  Product    Product?     @relation(fields: [ProductID], references: [ID])
  Production Production?  @relation(fields: [ProductionID], references: [ID])
  Sale      Sale?        @relation(fields: [SaleID], references: [ID])
  Reporter  User         @relation("DefectReporter", fields: [ReportedByID], references: [ID])
  Resolver  User?        @relation("DefectResolver", fields: [ResolvedByID], references: [ID])

  @@map("DefectReports")
}

// ─── Calibration ────────────────────────────────────────────────────────────────
model Calibration {
  ID                    Int       @id @default(autoincrement())
  EquipmentName          String    @db.VarChar(255)
  EquipmentCode          String    @db.VarChar(50)
  CalibrationInterval    Int?
  LastCalibrationDate    DateTime?
  NextCalibrationDate    DateTime?
  Status                 String    @default("OK") @db.VarChar(50)
  LastResult             String?   @db.VarChar(50)
  LastResultNotes        String?   @db.VarChar(1000)
  CreatedByID            String?
  CreatedAt              DateTime  @default(now())
  UpdatedAt              DateTime  @updatedAt

  Creator User? @relation(fields: [CreatedByID], references: [ID])

  @@map("Calibrations")
}

// ═══════════════════════════════════════════════════════════════════════════════
// ATTENDANCE INTEGRATION MODULE
// ═══════════════════════════════════════════════════════════════════════════════

// ─── AttendanceDeviceStatus ───────────────────────────────────────────────
model AttendanceDeviceStatus {
  ID          Int      @id @default(autoincrement())
  Code        String   @unique @db.VarChar(50)
  Name        String   @db.VarChar(100)
  Description String?  @db.VarChar(255)
  Color       String?  @db.VarChar(50)
  IsActive    Boolean  @default(true)
  SortOrder   Int      @default(0)
  CreatedAt   DateTime @default(now())
  UpdatedAt   DateTime @updatedAt

  Devices AttendanceDevice[]

  @@map("AttendanceDeviceStatuses")
}

// ─── AttendanceDevice ────────────────────────────────────────────────────
model AttendanceDevice {
  ID           Int                     @id @default(autoincrement())
  Code         String                  @unique @db.VarChar(50)
  Name         String                  @db.VarChar(255)
  Host         String                  @db.VarChar(100)
  Port         Int                     @default(4370)
  CommKey      String?                 @db.VarChar(100)
  DeviceType   String                  @default("FINGERPRINT") @db.VarChar(50)
  Location     String?                 @db.VarChar(255)
  Notes        String?                 @db.VarChar(1000)
  StatusID     Int                     @default(1)
  IsActive     Boolean                 @default(true)
  LastSyncAt   DateTime?
  CreatedAt    DateTime                @default(now())
  UpdatedAt    DateTime                @updatedAt

  Status AttendanceDeviceStatus @relation(fields: [StatusID], references: [ID])
  Logs   AttendanceDeviceLog[]
  Mappings EmployeeDeviceMapping[]

  @@map("AttendanceDevices")
}

// ─── EmployeeDeviceMapping ───────────────────────────────────────────────
model EmployeeDeviceMapping {
  ID                 Int       @id @default(autoincrement())
  EmployeeID         Int
  DeviceCode         String    @db.VarChar(50)
  FingerprintTemplate String?  @db.Text
  FaceTemplate       String?   @db.Text
  CreatedAt          DateTime  @default(now())
  UpdatedAt          DateTime  @updatedAt

  Employee Employee @relation(fields: [EmployeeID], references: [ID], onDelete: Cascade)
  Device   AttendanceDevice? @relation(fields: [DeviceID], references: [ID])
  DeviceID Int?

  @@unique([EmployeeID, DeviceCode])
