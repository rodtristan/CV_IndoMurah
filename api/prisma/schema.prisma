model ProductionItem {
  id            Int      @id @default(autoincrement())
  productionId  Int
  productId     Int
  productName   String   @db.VarChar(255)
  quantity      Decimal  @db.Decimal(15, 3)
  unitId        Int?
  unitPrice     Decimal  @default(0) @db.Decimal(15, 2)
  subtotal      Decimal  @default(0) @db.Decimal(15, 2)
  createdAt     DateTime @default(now())

  production Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  product    Product?   @relation(fields: [productId], references: [id])
  unit       Unit?      @relation(fields: [unitId], references: [id])

  @@map("production_items")
}

// ═══════════════════════════════════════════════════════════════════════════════
// HRM - HUMAN RESOURCE MANAGEMENT (from Ketoko reference)
// ═══════════════════════════════════════════════════════════════════════════════

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  RESIGNED
  TERMINATED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  SICK
  LEAVE
}

// ─── Department ────────────────────────────────────────────────
model Department {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(255)
  description String?  @db.VarChar(1000)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees Employee[]

  @@map("departments")
}

// ─── Position ─────────────────────────────────────────────────
model Position {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(255)
  description String?  @db.VarChar(1000)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees Employee[]

  @@map("positions")
}

// ─── Employee ─────────────────────────────────────────────────
model Employee {
  id            Int            @id @default(autoincrement())
  code          String         @unique @db.VarChar(50)
  name          String         @db.VarChar(255)
  departmentId  Int?
  positionId    Int?
  joinDate      DateTime?
  endDate       DateTime?
  birthDate     DateTime?
  gender        String?        @db.VarChar(20)
  phone         String?        @db.VarChar(50)
  email         String?        @db.VarChar(255)
  address       String?        @db.VarChar(500)
  emergencyContact String?     @db.VarChar(255)
  emergencyPhone   String?     @db.VarChar(50)
  basicSalary   Decimal        @default(0) @db.Decimal(15, 2)
  status        EmployeeStatus @default(ACTIVE)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  department Department?   @relation(fields: [departmentId], references: [id])
  position   Position?     @relation(fields: [positionId], references: [id])
  attendances Attendance[]
  payrolls   Payroll[]
  loans      Loan[]

  @@map("employees")
}

// ─── Attendance ───────────────────────────────────────────────
model Attendance {
  id         Int              @id @default(autoincrement())
  employeeId Int
  date       DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  status     AttendanceStatus @default(PRESENT)
  notes      String?          @db.VarChar(1000)
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@map("attendances")
}

// ─── Payroll ───────────────────────────────────────────────────
model Payroll {
  id           Int      @id @default(autoincrement())
  code         String   @unique @db.VarChar(50)
  employeeId   Int
  period       String   @db.VarChar(20) // e.g., "2024-01"
  basicSalary  Decimal  @db.Decimal(15, 2)
  allowances   Decimal  @default(0) @db.Decimal(15, 2)
  deductions   Decimal  @default(0) @db.Decimal(15, 2)
  overtimePay  Decimal  @default(0) @db.Decimal(15, 2)
  totalSalary  Decimal  @default(0) @db.Decimal(15, 2)
  paymentDate  DateTime?
  notes        String?  @db.VarChar(1000)
  isPaid       Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("payrolls")
}

// ─── Loan / Pinjaman ──────────────────────────────────────────
enum LoanStatus {
  PENDING
  APPROVED
  ACTIVE
  COMPLETED
  REJECTED
  CANCELLED
}

model Loan {
  id               Int        @id @default(autoincrement())
  code             String     @unique @db.VarChar(50)
  employeeId       Int
  loanType         String     @db.VarChar(100) // PERSONAL, EMERGENCY, HOUSING, VEHICLE
  principalAmount  Decimal    @db.Decimal(15, 2)
  interestRate     Decimal    @default(0) @db.Decimal(5, 2)
  tenorMonths      Int        @default(1)
  installmentAmount Decimal   @db.Decimal(15, 2)
  totalAmount      Decimal    @db.Decimal(15, 2)
  remainingAmount  Decimal    @db.Decimal(15, 2)
  startDate        DateTime?
  status           LoanStatus @default(PENDING)
  notes            String?    @db.VarChar(1000)
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  employee Employee   @relation(fields: [employeeId], references: [id])
  installments LoanInstallment[]

  @@map("loans")
}

// ─── Loan Installment ──────────────────────────────────────────
model LoanInstallment {
  id            Int      @id @default(autoincrement())
  loanId        Int
  period        String   @db.VarChar(20) // e.g., "2024-01"
  amount        Decimal  @db.Decimal(15, 2)
  principal     Decimal  @db.Decimal(15, 2)
  interest      Decimal  @db.Decimal(15, 2)
  remainingBefore Decimal @db.Decimal(15, 2)
  remainingAfter  Decimal @db.Decimal(15, 2)
  paymentDate   DateTime?
  status        String   @default("UNPAID") @db.VarChar(20) // PAID, UNPAID
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  loan Loan @relation(fields: [loanId], references: [id])

  @@map("loan_installments")
}

// ═══════════════════════════════════════════════════════════════════════════════
// NOTIFICATION (from Ketoko reference)
// ═══════════════════════════════════════════════════════════════════════════════

enum NotificationType {
  INFO
  WARNING
  ERROR
  SUCCESS
}

model Notification {
  id        Int                @id @default(autoincrement())
  userId    String?
  title     String            @db.VarChar(255)
  message   String            @db.VarChar(1000)
  type      NotificationType  @default(INFO)
  isRead    Boolean           @default(false)
  referenceType String?       @db.VarChar(100)
  referenceId   Int?
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("notifications")
}
