// ═══════════════════════════════════════════════════════════════════════════════
// ASSET MANAGEMENT (from Ketoko reference)
// ═══════════════════════════════════════════════════════════════════════════════

enum AssetStatus {
  ACTIVE
  MAINTENANCE
  DISPOSED
}

enum DepreciationMethod {
  STRAIGHT_LINE
  DECLINING_BALANCE
  UNITS_OF_PRODUCTION
}

// ─── Asset Category ────────────────────────────────────────────
model AssetCategory {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(255)
  description String?  @db.VarChar(1000)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assets Asset[]

  @@map("asset_categories")
}

// ─── Asset ─────────────────────────────────────────────────────
model Asset {
  id                 Int                 @id @default(autoincrement())
  code               String              @unique @db.VarChar(50)
  name               String              @db.VarChar(255)
  assetCategoryId    Int?
  purchaseDate       DateTime?
  purchasePrice      Decimal             @default(0) @db.Decimal(15, 2)
  currentValue       Decimal             @default(0) @db.Decimal(15, 2)
  depreciationMethod DepreciationMethod?
  usefulLifeYears    Int                 @default(0)
  location           String?             @db.VarChar(255)
  assignedTo         String?            @db.VarChar(255)
  serialNumber       String?             @db.VarChar(100)
  description        String?             @db.VarChar(1000)
  status             AssetStatus         @default(ACTIVE)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  category AssetCategory? @relation(fields: [assetCategoryId], references: [id])

  @@map("assets")
}

// ═══════════════════════════════════════════════════════════════════════════════
// SERVICE & REPAIR MANAGEMENT (from Ketoko reference)
// ═══════════════════════════════════════════════════════════════════════════════

enum RepairStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ─── Service ───────────────────────────────────────────────────
model Service {
  id               Int          @id @default(autoincrement())
  code             String       @unique @db.VarChar(50)
  date             DateTime     @default(now())
  customerId       Int?
  customerName     String?      @db.VarChar(255)
  customerPhone    String?      @db.VarChar(50)
  customerAddress  String?      @db.VarChar(500)
  productName      String?      @db.VarChar(255)
  serialNumber     String?      @db.VarChar(100)
  problem          String?      @db.VarChar(1000)
  diagnosis        String?      @db.VarChar(1000)
  repairStatus    RepairStatus @default(PENDING)
  technician      String?      @db.VarChar(255)
  warrantyUntil    DateTime?
  subtotal        Decimal      @default(0) @db.Decimal(15, 2)
  laborCost       Decimal      @default(0) @db.Decimal(15, 2)
  totalAmount     Decimal      @default(0) @db.Decimal(15, 2)
  notes           String?      @db.VarChar(1000)
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  customer Customer?   @relation(fields: [customerId], references: [id])
  items    ServiceItem[]

