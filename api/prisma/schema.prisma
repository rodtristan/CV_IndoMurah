// PRODUCTION MANAGEMENT (from Ketoko reference)
// ═══════════════════════════════════════════════════════════════════════════════

enum ProductionStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ─── Production ───────────────────────────────────────────────
model Production {
  id              Int               @id @default(autoincrement())
  code            String            @unique @db.VarChar(50)
  date            DateTime          @default(now())
  productId       Int?
  productName     String?           @db.VarChar(255)
  quantity        Decimal           @default(0) @db.Decimal(15, 3)
  warehouseId     Int?
  rawMaterialCost Decimal           @default(0) @db.Decimal(15, 2)
  laborCost       Decimal           @default(0) @db.Decimal(15, 2)
  overheadCost    Decimal           @default(0) @db.Decimal(15, 2)
  totalCost       Decimal           @default(0) @db.Decimal(15, 2)
  status          ProductionStatus  @default(PLANNING)
  notes           String?           @db.VarChar(1000)
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  warehouse Warehouse?        @relation(fields: [warehouseId], references: [id])
