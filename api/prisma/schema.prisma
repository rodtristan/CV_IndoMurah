// ============================================================
// Toko CV IndoMurah — Complete Prisma Schema
// POS System with OData Query Support
// All Status/Type are stored as tables (no enums)
// PascalCase naming convention for tables and columns
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════════════════════════
// REFERENCE DATA TABLES (Dinamis - bisa bertambah)
// ═══════════════════════════════════════════════════════════════════════════════

// ─── PaymentMethod (Metode Pembayaran) ───────────────────────────────
model PaymentMethod {
  ID          Int      @id @default(autoincrement())
  Code        String   @unique @db.VarChar(50)
  Name        String   @db.VarChar(100)
  Description String?  @db.VarChar(255)
  IsActive    Boolean  @default(true)
  SortOrder   Int      @default(0)
  CreatedAt   DateTime @default(now())
  UpdatedAt   DateTime @updatedAt

  // Relations
  SalePayments      SalePayment[]
  PurchasePayments   PurchasePayment[]
  Sales             Sale[]
  Purchases          Purchase[]
  CustomerDeposits  CustomerDeposit[]

  @@map("PaymentMethods")
}

// ─── PaymentStatus (Status Pembayaran) ────────────────────────────
model PaymentStatus {
  ID          Int      @id @default(autoincrement())
  Code        String   @unique @db.VarChar(50)
  Name        String   @db.VarChar(100)
  Description String?  @db.VarChar(255)
  Color       String?  @db.VarChar(50)
  IsActive    Boolean  @default(true)
  SortOrder   Int      @default(0)
  CreatedAt   DateTime @default(now())
  UpdatedAt   DateTime @updatedAt

  // Relations
  Sales      Sale[]
  Purchases   Purchase[]
  PurchaseOrders PurchaseOrder[]

  @@map("PaymentStatuses")
}

// ─── TransactionStatus (Status Transaksi) ──────────────────────
model TransactionStatus {
  ID          Int      @id @default(autoincrement())
  Code        String   @unique @db.VarChar(50)
  Name        String   @db.VarChar(100)
  Description String?  @db.VarChar(255)
  Color       String?  @db.VarChar(50)
  IsTerminal  Boolean  @default(false)
  IsActive    Boolean  @default(true)
  SortOrder   Int      @default(0)
  CreatedAt   DateTime @default(now())
  UpdatedAt   DateTime @updatedAt

  // Relations
  SaleReturns      SaleReturn[]
  PurchaseOrders   PurchaseOrder[]
  Purchases        Purchase[]
  StockIns         StockIn[]
  StockOuts        StockOut[]
  StockTransfers   StockTransfer[]
  PurchaseReturns  PurchaseReturn[]
  Transfers        Transfer[]
  WorkOrders       WorkOrder[]
  Assemblies       Assembly[]
  QCInspections    QCInspection[]

  @@map("TransactionStatuses")
}

// ─── StockOpnameStatus ─────────────────────────────────────────
model StockOpnameStatus {
  ID          Int      @id @default(autoincrement())
  Code        String   @unique @db.VarChar(50)
  Name        String   @db.VarChar(100)
  Description String?  @db.VarChar(255)
  Color       String?  @db.VarChar(50)
  IsActive    Boolean  @default(true)
  SortOrder   Int      @default(0)
  CreatedAt   DateTime @default(now())
  UpdatedAt   DateTime @updatedAt

  // Relations
  StockOpnames StockOpname[]

  @@map("StockOpnameStatuses")
}

// ─── AccountType (Tipe Akun) ──────────────────────────────────
model AccountType {
  ID          Int      @id @default(autoincrement())
  Code        String   @unique @db.VarChar(50)
  Name        String   @db.VarChar(100)
  Description String?  @db.VarChar(255)
  IsDebitNormal Boolean @default(true)
  IsActive    Boolean  @default(true)
  SortOrder   Int      @default(0)
  CreatedAt   DateTime @default(now())
  UpdatedAt   DateTime @updatedAt

  // Relations
  Accounts    Account[]

  @@map("AccountTypes")
}

// ─── ReferenceType (Tipe Referensi) ────────────────────────────
model ReferenceType {
  ID          Int      @id @default(autoincrement())
  Code        String   @unique @db.VarChar(50)
  Name        String   @db.VarChar(100)
  Description String?  @db.VarChar(255)
  IsActive    Boolean  @default(true)
  SortOrder   Int      @default(0)
  CreatedAt   DateTime @default(now())
  UpdatedAt   DateTime @updatedAt

  // Relations
  StockIns    StockIn[]
  StockOuts   StockOut[]

  @@map("ReferenceTypes")
}

// ─── CustomerGroup (Grup Pelanggan) ────────────────────────────
model CustomerGroup {
  ID              Int       @id @default(autoincrement())
  Code            String    @unique @db.VarChar(50)
  Name            String    @db.VarChar(100)
  Description     String?   @db.VarChar(255)
  DiscountPercent Decimal    @default(0) @db.Decimal(5,2)
  PointMultiplier Decimal    @default(1) @db.Decimal(3,2)
  IsActive        Boolean   @default(true)
  SortOrder       Int       @default(0)
  CreatedAt       DateTime  @default(now())
  UpdatedAt       DateTime  @updatedAt

  // Relations
  Customers Customer[]

  @@map("CustomerGroups")
}

// ─── EmployeeStatus ────────────────────────────────────────────
model EmployeeStatus {
  ID          Int      @id @default(autoincrement())
  Code        String   @unique @db.VarChar(50)
  Name        String   @db.VarChar(100)
  Description String?  @db.VarChar(255)
  Color       String?  @db.VarChar(50)
  IsActive    Boolean  @default(true)
  SortOrder   Int      @default(0)
  CreatedAt   DateTime @default(now())
  UpdatedAt   DateTime @updatedAt

  // Relations
  Employees Employee[]

