  Date          DateTime          @default(now())
  WarehouseID   Int
  SupplierID    Int?
  ReferenceTypeID Int?
  ReferenceID   Int?
  TotalItems    Decimal           @default(0) @db.Decimal(15, 2)
  Description   String?           @db.VarChar(1000)
