// ============================================================
// Toko CV IndoMurah — Complete Prisma Schema
// POS System with OData Query Support
// All Status/Type are stored as tables (no enums)
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════════════════════════
// REFERENCE DATA TABLES (Dinamis - bisa bertambah)
// ═══════════════════════════════════════════════════════════════════════════════

// Status/type fields below use plain enums, not lookup tables. A schema-expansion
// commit briefly converted these to FK-based lookup tables (PaymentMethod,
// PaymentStatus, TransactionStatus, AccountType, StockOpnameStatus models) but
// that migration was never finished — the DB was never migrated, the service
// layer was never updated, and it broke `prisma generate`. Reverted back to
// enums until that refactor is completed properly and coordinated across the
// service layer + frontend.

enum PaymentMethod {
  CASH
  TRANSFER
  DEBIT
  QRIS
  CREDIT
}

enum PaymentStatus {
  PENDING
  PAID
  INSTALMENT
  PARTIAL
  CANCELLED
}

enum TransactionStatus {
  DRAFT
  PENDING
  CONFIRMED
  SENT
  RECEIVED
  COMPLETED
  APPROVED
  CANCELLED
}

enum StockOpnameStatus {
  PENDING
  APPROVED
  COMPLETED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum ReferenceType {
  PURCHASE
  RETURN
  ADJUSTMENT
  MANUAL
}

enum CustomerGroup {
  RETAIL
  WHOLESALE
  VIP
  GENERAL
}

// ─── EmployeeStatus ────────────────────────────────────────────
model EmployeeStatus {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  color       String?  @db.VarChar(50)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  employees Employee[]

  @@map("employee_statuses")
}

// ─── AttendanceStatus ──────────────────────────────────────────
model AttendanceStatus {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  color       String?  @db.VarChar(50)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  attendances Attendance[]

  @@map("attendance_statuses")
}

// ─── LeaveType ────────────────────────────────────────────────
model LeaveType {
  id              Int       @id @default(autoincrement())
  code            String    @unique @db.VarChar(50)
  name            String    @db.VarChar(100)
  description     String?   @db.VarChar(255)
  isPaidLeave     Boolean   @default(true)
  defaultDays     Int       @default(0)  // Default annual entitlement
  color           String?   @db.VarChar(50)
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  leaves         Leave[]
  leaveBalances  LeaveBalance[]

  @@map("leave_types")
}

// ─── LeaveStatus ────────────────────────────────────────────────
model LeaveStatus {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  color       String?  @db.VarChar(50)
  requiresApproval Boolean @default(true)
  isTerminal  Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  leaves Leave[]

  @@map("leave_statuses")
}

// ─── LoanStatus ────────────────────────────────────────────────
model LoanStatus {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  color       String?  @db.VarChar(50)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  loans Loan[]

  @@map("loan_statuses")
}

// ─── LoanType ─────────────────────────────────────────────────
model LoanType {
  id              Int       @id @default(autoincrement())
  code            String    @unique @db.VarChar(50)
  name            String    @db.VarChar(100)
  description     String?   @db.VarChar(255)
  maxTenorMonths  Int       @default(12)
  maxAmount       Decimal   @default(0) @db.Decimal(15,2)
  interestRate    Decimal   @default(0) @db.Decimal(5,2)
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  loans Loan[]

  @@map("loan_types")
}

// ─── AssetStatus ──────────────────────────────────────────────
model AssetStatus {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  color       String?  @db.VarChar(50)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  assets Asset[]

  @@map("asset_statuses")
}

// ─── DepreciationMethod ──────────────────────────────────────
model DepreciationMethod {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  formula     String?  @db.VarChar(255)  // Formula description
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  assets Asset[]

  @@map("depreciation_methods")
}

// ─── RepairStatus ─────────────────────────────────────────────
model RepairStatus {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  color       String?  @db.VarChar(50)
  isTerminal  Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  services Service[]

  @@map("repair_statuses")
}

// ─── ProductionStatus ─────────────────────────────────────────
model ProductionStatus {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  color       String?  @db.VarChar(50)
  isTerminal  Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  productions Production[]

  @@map("production_statuses")
}

// ─── VoucherType ──────────────────────────────────────────────
model VoucherType {
  id              Int       @id @default(autoincrement())
  code            String    @unique @db.VarChar(50)
  name            String    @db.VarChar(100)
  description     String?   @db.VarChar(255)
  hasMaxDiscount  Boolean   @default(false)  // Has max discount cap
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  vouchers Voucher[]

  @@map("voucher_types")
}

// ─── NotificationType ─────────────────────────────────────────
model NotificationType {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  icon        String?  @db.VarChar(50)
  color       String?  @db.VarChar(50)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  notifications        Notification[]
  notificationSettings NotificationSetting[]

  @@map("notification_types")
}

// ─── AlertType (Stock Alert Types) ────────────────────────────
model AlertType {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  color       String?  @db.VarChar(50)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  stockAlerts StockAlert[]

  @@map("alert_types")
}

// ─── NotificationChannel (Email, Push, In-App) ────────────────
model NotificationChannel {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  icon        String?  @db.VarChar(50)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("notification_channels")
}

// ═══════════════════════════════════════════════════════════════════════════════
// AUTH & USER MANAGEMENT
// ═══════════════════════════════════════════════════════════════════════════════

model User {
  id          String   @id @default(uuid())
  companyId   Int
  username    String   @db.VarChar(100)
  email       String?  @unique @db.VarChar(255)
  password    String   @db.VarChar(255)
  name        String   @db.VarChar(255)
  role        String   @default("cashier") @db.VarChar(100)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@unique([companyId, username])
  @@index([companyId])

  // Relations - Purchase transactions
  purchaseOrders   PurchaseOrder[]
  purchases        Purchase[]
  purchasePayments PurchasePayment[]
  purchaseReturns  PurchaseReturn[]

  // Relations - Stock transactions
  stockIns       StockIn[]
  stockOuts      StockOut[]
  stockTransfers StockTransfer[]
  stockOpnames   StockOpname[]

  // Relations - Sales transactions
  sales        Sale[]
  salePayments SalePayment[]
  saleReturns  SaleReturn[]

  // Relations - Accounting
  cashIns          CashIn[]
  cashOuts         CashOut[]
  cashTransfers    CashTransfer[]
  customerDeposits CustomerDeposit[]
  supplierDeposits SupplierDeposit[]
  journalEntries   JournalEntry[]
  journals             Journal[]
  pointRedemptions     PointRedemption[]
  approvedExpenses     Expense[]
  notifications        Notification[]
  notificationSettings NotificationSetting[]
  approvedLeaves       Leave[]
  userRoles            UserRole[]
  userMenus            UserMenu[]

  @@map("users")
}

model Role {
  id              Int      @id @default(autoincrement())
  roleName        String   @unique @db.VarChar(100)
  roleDescription String?  @db.VarChar(500)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  userRoles UserRole[]
  roleMenus RoleMenu[]

  @@map("roles")
}

model Menu {
  id           Int      @id @default(autoincrement())
  menuName     String   @db.VarChar(255)
  menuType     String?  @db.VarChar(50)
  icon         String?  @db.VarChar(100)
  route        String?  @db.VarChar(500)
  parentMenuId Int?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  parentMenu Menu?      @relation("MenuParent", fields: [parentMenuId], references: [id])
  childMenus Menu[]     @relation("MenuParent")
  userMenus  UserMenu[]
  roleMenus  RoleMenu[]

  @@map("menus")
}

model UserRole {
  id        Int      @id @default(autoincrement())
  userId    String
  roleId    Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RoleMenu {
  id        Int      @id @default(autoincrement())
  roleId    Int
  menuId    Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([roleId, menuId])
  @@map("role_menus")
}

model UserMenu {
  id        Int      @id @default(autoincrement())
  userId    String
  menuId    Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([userId, menuId])
  @@map("user_menus")
}

// ─── Log ─────────────────────────────────────────────────────
model Log {
  id                Int      @id @default(autoincrement())
  method            String?  @db.VarChar(20)
  endpoint          String?  @db.VarChar(500)
  headers           Json?
  payload           Json?
  responseStatus    Int?
  message           String?  @db.VarChar(1000)
  requesterLoginId  Int?
  requesterFullName String?  @db.VarChar(255)
  ipAddress         String?  @db.VarChar(100)
  userAgent         String?  @db.VarChar(500)
  durationMs        Int?
  logDatetime       DateTime @default(now())
  createdAt         DateTime @default(now())

  @@map("logs")
}

// ═══════════════════════════════════════════════════════════════════════════════
// MASTER DATA MODULES
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Category ──────────────────────────────────────────────
model Category {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(255)
  icon        String?  @db.VarChar(100)
  image       String?  @db.VarChar(500)
  description String?  @db.VarChar(1000)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@map("categories")
}

// ─── Brand ─────────────────────────────────────────────────
model Brand {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(255)
  description String?  @db.VarChar(1000)
  logoUrl     String?  @db.VarChar(500)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
  brandLogos BrandLogo[]

  @@map("brands")
}

// ─── Unit ──────────────────────────────────────────────────
model Unit {
  id           Int      @id @default(autoincrement())
  code         String   @unique @db.VarChar(50)
  name         String   @db.VarChar(100)
  abbreviation String?  @db.VarChar(20)
  description  String?  @db.VarChar(500)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  products            Product[]
  purchaseOrderItems  PurchaseOrderItem[]
  purchaseItems       PurchaseItem[]
  stockInItems        StockInItem[]
  stockOutItems       StockOutItem[]
  stockTransferItems  StockTransferItem[]
  stockOpnameItems    StockOpnameItem[]
  saleItems           SaleItem[]
  saleReturnItems     SaleReturnItem[]
  purchaseReturnItems PurchaseReturnItem[]
  productionItems     ProductionItem[]

  @@map("units")
}

// ─── Warehouse ─────────────────────────────────────────────
model Warehouse {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(50)
  name      String   @db.VarChar(255)
  address   String?  @db.VarChar(500)
  phone     String?  @db.VarChar(50)
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  products           Product[]
  productStocks      ProductStock[]
  stockIns           StockIn[]
  stockOuts          StockOut[]
  stockTransfersFrom StockTransfer[]  @relation("TransferFrom")
  stockTransfersTo   StockTransfer[]  @relation("TransferTo")
  stockOpnames       StockOpname[]
  sales              Sale[]
  purchases          Purchase[]
  purchaseOrders     PurchaseOrder[]
  saleReturns        SaleReturn[]
  purchaseReturns    PurchaseReturn[]
  salePoints         SalePoint[]
  transfersFrom     Transfer[]       @relation("TransferFromWarehouse")
  transfersTo       Transfer[]        @relation("TransferToWarehouse")
  productions        Production[]
  shelves           Shelf[]

  @@map("warehouses")
}

// ─── Shelf (Rak) ─────────────────────────────────────────────
model Shelf {
  id          Int      @id @default(autoincrement())
  warehouseId Int
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(255)
  description String?  @db.VarChar(500)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  shelfProducts ShelfProduct[]

  @@map("shelves")
}

// ─── Shelf Product (Produk di Rak) ───────────────────────────
model ShelfProduct {
  id        Int      @id @default(autoincrement())
  shelfId   Int
  productId Int
  quantity  Decimal  @default(0) @db.Decimal(15, 3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shelf   Shelf   @relation(fields: [shelfId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([shelfId, productId])
  @@map("shelf_products")
}

// ─── Product Group (Golongan Produk) ─────────────────────────
model ProductGroup {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(255)
  description String?  @db.VarChar(500)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@map("product_groups")
}

// ─── Supplier ───────────────────────────────────────────────
model Supplier {
  id            Int      @id @default(autoincrement())
  code          String   @unique @db.VarChar(50)
  name          String   @db.VarChar(255)
  contactPerson String?  @db.VarChar(255)
  phone         String?  @db.VarChar(50)
  email         String?  @db.VarChar(255)
  address       String?  @db.VarChar(500)
  totalDebt     Decimal  @default(0) @db.Decimal(15, 2)
  notes         String?  @db.VarChar(1000)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchaseOrders   PurchaseOrder[]
  purchases        Purchase[]
  stockIns         StockIn[]
  supplierDeposits SupplierDeposit[]
  purchaseReturns  PurchaseReturn[]

  @@map("suppliers")
}

// ─── Customer ───────────────────────────────────────────────
model Customer {
  id              Int           @id @default(autoincrement())
  code            String        @unique @db.VarChar(50)
  name            String        @db.VarChar(255)
  phone           String?       @db.VarChar(50)
  email           String?       @db.VarChar(255)
  address         String?       @db.VarChar(500)
  totalReceivable Decimal       @default(0) @db.Decimal(15, 2)
  customerGroup   CustomerGroup @default(GENERAL)
  pointBalance    Int           @default(0)
  notes           String?       @db.VarChar(1000)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  sales            Sale[]
  customerDeposits CustomerDeposit[]
  pointRedemptions PointRedemption[]
  saleReturns      SaleReturn[]
  services        Service[]

  @@map("customers")
}

// ─── Sales Person ──────────────────────────────────────────
model SalesPerson {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(50)
  name      String   @db.VarChar(255)
  phone     String?  @db.VarChar(50)
  email     String?  @db.VarChar(255)
  address   String?  @db.VarChar(500)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales Sale[]

  @@map("sales_people")
}

// ─── Sale Point ─────────────────────────────────────────────
model SalePoint {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(255)
  warehouseId Int?
  description String?  @db.VarChar(500)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])
  sales     Sale[]

  @@map("sale_points")
}

// ─── Product ────────────────────────────────────────────────
model Product {
  id              Int      @id @default(autoincrement())
  code            String   @unique @db.VarChar(50)
  barcode         String?  @db.VarChar(100)
  name            String   @db.VarChar(255)
  categoryId      Int?
  brandId         Int?
  unitId          Int
  warehouseId     Int?
  purchasePrice   Decimal  @default(0) @db.Decimal(15, 2)
  sellingPrice    Decimal  @default(0) @db.Decimal(15, 2)
  discountPercent Decimal  @default(0) @db.Decimal(5, 2)
  stock           Decimal  @default(0) @db.Decimal(15, 3)
  minimumStock    Decimal  @default(0) @db.Decimal(15, 3)
  image           String?  @db.VarChar(500)
  description     String?  @db.VarChar(1000)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category  Category?  @relation(fields: [categoryId], references: [id])
  brand     Brand?     @relation(fields: [brandId], references: [id])
  unit      Unit       @relation(fields: [unitId], references: [id])
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])

  // Relations
  purchaseOrderItems  PurchaseOrderItem[]
  purchaseItems       PurchaseItem[]
  purchaseReturnItems PurchaseReturnItem[]
  stockInItems        StockInItem[]
  stockOutItems       StockOutItem[]
  stockTransferItems  StockTransferItem[]
  stockOpnameItems    StockOpnameItem[]
  saleItems           SaleItem[]
  saleReturnItems     SaleReturnItem[]
  productStocks       ProductStock[]
  priceHistories      PriceHistory[]
  serviceItems        ServiceItem[]
  productionItems     ProductionItem[]
  productions         Production[]
  productImages       ProductImage[]
  productBarcodes     ProductBarcode[]
  stockAlerts         StockAlert[]
  productGroupId      Int?
  productGroup        ProductGroup? @relation(fields: [productGroupId], references: [id])
  shelfProducts       ShelfProduct[]

  @@map("products")
}

// ─── Product Stock (per warehouse) ────────────────────────────
model ProductStock {
  id           Int      @id @default(autoincrement())
  productId    Int
  warehouseId  Int
  quantity     Decimal  @default(0) @db.Decimal(15, 3)
  minimumStock Decimal  @default(0) @db.Decimal(15, 3)
  updatedAt    DateTime @updatedAt

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@map("product_stocks")
}

// ═══════════════════════════════════════════════════════════════════════════════
// SALE TRANSACTIONS
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Sale ───────────────────────────────────────────────────
model Sale {
  id              Int            @id @default(autoincrement())
  code            String         @unique @db.VarChar(50)
  date            DateTime       @default(now())
  customerId      Int
  salesPersonId   Int?
  salePointId     Int?
  warehouseId     Int?
  subtotal        Decimal        @default(0) @db.Decimal(15, 2)
