// ACCOUNTING
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Account ────────────────────────────────────────────────
model Account {
  id        Int         @id @default(autoincrement())
  code      String      @unique @db.VarChar(50)
  name      String      @db.VarChar(255)
  type      AccountType
  parentId  Int?
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  parent   Account?  @relation("AccountParent", fields: [parentId], references: [id])
  children Account[] @relation("AccountParent")

  // Accounting relations
  cashIns           CashIn[]
  cashOuts          CashOut[]
  cashTransfersFrom CashTransfer[] @relation("CashTransferFrom")
  cashTransfersTo   CashTransfer[] @relation("CashTransferTo")
  journalEntries    JournalEntry[]
  transfersFrom    Transfer[]      @relation("TransferFromAccount")
  transfersTo      Transfer[]      @relation("TransferToAccount")

  @@map("accounts")
}

// ─── Journal ─────────────────────────────────────────────────
model Journal {
  id            Int       @id @default(autoincrement())
  code          String    @unique @db.VarChar(50)
  date          DateTime  @default(now())
  description   String?   @db.VarChar(1000)
  referenceType String?   @db.VarChar(100)
  referenceId   Int?
  isPosted      Boolean   @default(false)
  postedAt      DateTime?
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  creator User @relation(fields: [createdById], references: [id])

  journalEntries JournalEntry[]

  @@map("journals")
}

// ─── Journal Entry ───────────────────────────────────────────
model JournalEntry {
  id        Int      @id @default(autoincrement())
