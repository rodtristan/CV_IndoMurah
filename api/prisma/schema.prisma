}

// ─── LoanType ─────────────────────────────────────────────────
model LoanType {
  ID              Int       @id @default(autoincrement())
  Code            String    @unique @db.VarChar(50)
  Name            String    @db.VarChar(100)
  Description     String?   @db.VarChar(255)
  MaxTenorMonths  Int       @default(12)
  MaxAmount       Decimal   @default(0) @db.Decimal(15,2)
  InterestRate    Decimal   @default(0) @db.Decimal(5,2)
  IsActive        Boolean   @default(true)
  SortOrder       Int       @default(0)
  CreatedAt       DateTime  @default(now())
  UpdatedAt       DateTime  @updatedAt

  // Relations
  Loans Loan[]

  @@map("LoanTypes")
}

// ─── AssetStatus ──────────────────────────────────────────────
model AssetStatus {
  ID          Int      @id @default(autoincrement())
  Code        String   @unique @db.VarChar(50)
  Name        String   @db.VarChar(100)
  Description String?  @db.VarChar(255)
  Color       String?  @db.VarChar(50)
  IsActive    Boolean  @default(true)
  SortOrder   Int      @default(0)
  CreatedAt   DateTime @default(now())
  UpdatedAt   DateTime @updatedAt

  // Relations
  Assets Asset[]

  @@map("AssetStatuses")
}

// ─── DepreciationMethod ──────────────────────────────────────
model DepreciationMethod {
  ID          Int      @id @default(autoincrement())
  Code        String   @unique @db.VarChar(50)
  Name        String   @db.VarChar(100)
  Description String?  @db.VarChar(255)
  Formula     String?  @db.VarChar(255)
  IsActive    Boolean  @default(true)
  SortOrder   Int      @default(0)
  CreatedAt   DateTime @default(now())
  UpdatedAt   DateTime @updatedAt

  // Relations
  Assets Asset[]

  @@map("DepreciationMethods")
}

// ─── RepairStatus ─────────────────────────────────────────────
model RepairStatus {
  ID          Int      @id @default(autoincrement())
  Code        String   @unique @db.VarChar(50)
  Name        String   @db.VarChar(100)
  Description String?  @db.VarChar(255)
  Color       String?  @db.VarChar(50)
  IsTerminal  Boolean  @default(false)
  IsActive    Boolean  @default(true)
  SortOrder   Int      @default(0)
  CreatedAt   DateTime @default(now())
  UpdatedAt   DateTime @updatedAt

  // Relations
  Services Service[]

  @@map("RepairStatuses")
}

// ─── ProductionStatus ─────────────────────────────────────────
model ProductionStatus {
  ID          Int      @id @default(autoincrement())
  Code        String   @unique @db.VarChar(50)
  Name        String   @db.VarChar(100)
  Description String?  @db.VarChar(255)
  Color       String?  @db.VarChar(50)
  IsTerminal  Boolean  @default(false)
  IsActive    Boolean  @default(true)
  SortOrder   Int      @default(0)
  CreatedAt   DateTime @default(now())
  UpdatedAt   DateTime @updatedAt

  // Relations
  Productions Production[]

  @@map("ProductionStatuses")
}

// ─── VoucherType ──────────────────────────────────────────────
model VoucherType {
  ID              Int       @id @default(autoincrement())
  Code            String    @unique @db.VarChar(50)
  Name            String    @db.VarChar(100)
  Description     String?   @db.VarChar(255)
  HasMaxDiscount  Boolean   @default(false)
  IsActive        Boolean   @default(true)
  SortOrder       Int       @default(0)
  CreatedAt       DateTime  @default(now())
  UpdatedAt       DateTime  @updatedAt

  // Relations
  Vouchers Voucher[]

  @@map("VoucherTypes")
}

// ─── NotificationType ─────────────────────────────────────────
model NotificationType {
  ID          Int      @id @default(autoincrement())
  Code        String   @unique @db.VarChar(50)
  Name        String   @db.VarChar(100)
  Description String?  @db.VarChar(255)
  Icon        String?  @db.VarChar(50)
  Color       String?  @db.VarChar(50)
  IsActive    Boolean  @default(true)
  SortOrder   Int      @default(0)
  CreatedAt   DateTime @default(now())
  UpdatedAt   DateTime @updatedAt

  // Relations
  Notifications        Notification[]
  NotificationSettings NotificationSetting[]

  @@map("NotificationTypes")
}

// ─── AlertType (Stock Alert Types) ────────────────────────────
model AlertType {
  ID          Int      @id @default(autoincrement())
  Code        String   @unique @db.VarChar(50)
  Name        String   @db.VarChar(100)
  Description String?  @db.VarChar(255)
  Color       String?  @db.VarChar(50)
  IsActive    Boolean  @default(true)
  SortOrder   Int      @default(0)
  CreatedAt   DateTime @default(now())
  UpdatedAt   DateTime @updatedAt

  // Relations
  StockAlerts StockAlert[]

  @@map("AlertTypes")
}

// ─── NotificationChannel (Email, Push, In-App) ────────────────
model NotificationChannel {
  ID          Int      @id @default(autoincrement())
  Code        String   @unique @db.VarChar(50)
  Name        String   @db.VarChar(100)
  Description String?  @db.VarChar(255)
  Icon        String?  @db.VarChar(50)
  IsActive    Boolean  @default(true)
  SortOrder   Int      @default(0)
  CreatedAt   DateTime @default(now())
  UpdatedAt   DateTime @updatedAt

  @@map("NotificationChannels")
}

// ═══════════════════════════════════════════════════════════════════════════════
// AUTH & USER MANAGEMENT
// ═══════════════════════════════════════════════════════════════════════════════

model User {
  ID          String   @id @default(uuid())
  CompanyID   Int
  Username    String   @db.VarChar(100)
  Email       String?  @unique @db.VarChar(255)
  Password    String   @db.VarChar(255)
  Name        String   @db.VarChar(255)
  Role        String   @default("cashier") @db.VarChar(100)
  IsActive    Boolean  @default(true)
  CreatedAt   DateTime @default(now())
  UpdatedAt   DateTime @updatedAt

  Company     Company  @relation(fields: [CompanyID], references: [ID], onDelete: Cascade)
  @@unique([CompanyID, Username])
  @@index([CompanyID])

  // Relations
  UserRoles UserRole[]
  UserMenus UserMenu[]

  // Relations - Purchase transactions
  PurchaseOrders   PurchaseOrder[]
  Purchases        Purchase[]
  PurchasePayments PurchasePayment[]
  PurchaseReturns  PurchaseReturn[]

  // Relations - Stock transactions
  StockIns       StockIn[]
  StockOuts      StockOut[]
  StockTransfers StockTransfer[]
  StockOpnames   StockOpname[]

  // Relations - Sales transactions
  Sales        Sale[]
  SalePayments SalePayment[]
  SaleReturns  SaleReturn[]

  // Relations - Accounting
  CashIns          CashIn[]
  CashOuts         CashOut[]
  CashTransfers    CashTransfer[]
  CustomerDeposits CustomerDeposit[]
  SupplierDeposits SupplierDeposit[]
  JournalEntries   JournalEntry[]
  Journals             Journal[]
  PointRedemptions     PointRedemption[]
  MemberCardTransactions MemberCardTransaction[]
  ApprovedExpenses     Expense[]
  Notifications        Notification[]
  NotificationSettings NotificationSetting[]
  NotificationLogs     NotificationLog[]
  ApprovedLeaves       Leave[]

  // Relations - QC
  DefectReportsFiled  DefectReport[] @relation("DefectReporter")
  DefectReportsResolvedBy DefectReport[] @relation("DefectResolver")

  // Relations - Other
  StockMutations     StockMutation[]
  CashFlowTransactions CashFlowTransaction[]
  QCChecks          QCCheck[]
  Calibrations      Calibration[]
  QCInspectionsCreatedBy QCInspection[] @relation("InspectionCreator")
  QCInspectionsInspectedBy QCInspection[] @relation("QCInspectionsInspectedBy")
  QCInspectionItemsInspectedBy QCInspectionItem[] @relation("QCInspectionItemsInspectedBy")

  // Relations - Accounting
  JournalEntryLines   JournalEntryLine[]
  ClosingEntries     ClosingEntry[]

  @@map("Users")
}

model Role {
  ID              Int      @id @default(autoincrement())
  RoleName        String   @unique @db.VarChar(100)
  RoleDescription String?  @db.VarChar(500)
  IsActive        Boolean  @default(true)
  CreatedAt       DateTime @default(now())
  UpdatedAt       DateTime @updatedAt

  UserRoles UserRole[]
  RoleMenus RoleMenu[]

  @@map("Roles")
}

model Menu {
  ID           Int      @id @default(autoincrement())
  MenuName     String   @db.VarChar(255)
  MenuType     String?  @db.VarChar(50)
  Icon         String?  @db.VarChar(100)
  Route        String?  @db.VarChar(500)
  ParentMenuID Int?
  IsActive     Boolean  @default(true)
  SortOrder    Int      @default(0)
  CreatedAt    DateTime @default(now())
  UpdatedAt    DateTime @updatedAt

  ParentMenu Menu?      @relation("MenuParent", fields: [ParentMenuID], references: [ID])
  ChildMenus Menu[]     @relation("MenuParent")
  UserMenus  UserMenu[]
  RoleMenus  RoleMenu[]

  @@map("Menus")
}

model UserRole {
  ID        Int      @id @default(autoincrement())
  UserID    String
  RoleID    Int
  IsActive  Boolean  @default(true)
  CreatedAt DateTime @default(now())
  UpdatedAt DateTime @updatedAt

  User User @relation(fields: [UserID], references: [ID], onDelete: Cascade)
  Role Role @relation(fields: [RoleID], references: [ID], onDelete: Cascade)

  @@unique([UserID, RoleID])
  @@map("UserRoles")
}

model RoleMenu {
  ID        Int      @id @default(autoincrement())
  RoleID    Int
  MenuID    Int
  IsActive  Boolean  @default(true)
  CreatedAt DateTime @default(now())
  UpdatedAt DateTime @updatedAt

  Role Role @relation(fields: [RoleID], references: [ID], onDelete: Cascade)
  Menu Menu @relation(fields: [MenuID], references: [ID], onDelete: Cascade)

  @@unique([RoleID, MenuID])
  @@map("RoleMenus")
}

model UserMenu {
  ID        Int      @id @default(autoincrement())
  UserID    String
  MenuID    Int
  IsActive  Boolean  @default(true)
  CreatedAt DateTime @default(now())
  UpdatedAt DateTime @updatedAt

  User User @relation(fields: [UserID], references: [ID], onDelete: Cascade)
  Menu Menu @relation(fields: [MenuID], references: [ID], onDelete: Cascade)

  @@unique([UserID, MenuID])
  @@map("UserMenus")
}

// ─── Log ─────────────────────────────────────────────────────
model Log {
  ID                Int      @id @default(autoincrement())
  Method            String?  @db.VarChar(20)
  Endpoint          String?  @db.VarChar(500)
  Headers           Json?
  Payload           Json?
  ResponseStatus    Int?
  Message           String?  @db.VarChar(1000)
  RequesterLoginID  Int?
  RequesterFullName String?  @db.VarChar(255)
  IpAddress         String?  @db.VarChar(100)
  UserAgent         String?  @db.VarChar(500)
  DurationMs        Int?
  LogDatetime       DateTime @default(now())
  CreatedAt         DateTime @default(now())

  @@map("Logs")
}

// ═══════════════════════════════════════════════════════════════════════════════
// MASTER DATA MODULES
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Category ──────────────────────────────────────────────
model Category {
  ID          Int      @id @default(autoincrement())
  Code        String   @unique @db.VarChar(50)
  Name        String   @db.VarChar(255)
  Icon        String?  @db.VarChar(100)
  Image       String?  @db.VarChar(500)
  Description String?  @db.VarChar(1000)
  IsActive    Boolean  @default(true)
  CreatedAt   DateTime @default(now())
  UpdatedAt   DateTime @updatedAt

  Products Product[]

  @@map("Categories")
}

// ─── Brand ─────────────────────────────────────────────────
model Brand {
  ID          Int      @id @default(autoincrement())
  Code        String   @unique @db.VarChar(50)
  Name        String   @db.VarChar(255)
  Description String?  @db.VarChar(1000)
  LogoUrl     String?  @db.VarChar(500)
  IsActive    Boolean  @default(true)
  CreatedAt   DateTime @default(now())
  UpdatedAt   DateTime @updatedAt

  Products Product[]
  BrandLogos BrandLogo[]

  @@map("Brands")
}

// ─── Unit ──────────────────────────────────────────────────
model Unit {
  ID           Int      @id @default(autoincrement())
  Code         String   @unique @db.VarChar(50)
  Name         String   @db.VarChar(100)
  Abbreviation String?  @db.VarChar(20)
  Description  String?  @db.VarChar(500)
  IsActive     Boolean  @default(true)
  CreatedAt    DateTime @default(now())
  UpdatedAt    DateTime @updatedAt

  // Relations
  Products            Product[]
  PurchaseOrderItems  PurchaseOrderItem[]
  PurchaseItems       PurchaseItem[]
  StockInItems        StockInItem[]
  StockOutItems       StockOutItem[]
  StockTransferItems  StockTransferItem[]
  StockOpnameItems    StockOpnameItem[]
  SaleItems           SaleItem[]
  SaleReturnItems     SaleReturnItem[]
  PurchaseReturnItems PurchaseReturnItem[]
  ProductionItems     ProductionItem[]
  StockMutationItems  StockMutationItem[]
  ProductionMaterials ProductionMaterial[]
  QCInspectionItems   QCInspectionItem[]
  WorkOrderItems     WorkOrderItem[]
  BOMItems          BOMItem[]
  AssemblyComponents AssemblyComponent[]
  ProductPrices     ProductPrice[]
  ProductUnits      ProductUnit[]
  ProductionRecipeItems ProductionRecipeItem[]
  ProductionRequestItems ProductionRequestItem[]

  @@map("Units")
}

// ─── Warehouse ─────────────────────────────────────────────
model Warehouse {
  ID        Int      @id @default(autoincrement())
  Code      String   @unique @db.VarChar(50)
  Name      String   @db.VarChar(255)
  Address   String?  @db.VarChar(500)
  Phone     String?  @db.VarChar(50)
  IsDefault Boolean  @default(false)
  IsActive  Boolean  @default(true)
  CreatedAt DateTime @default(now())
  UpdatedAt DateTime @updatedAt

  // Relations
  Products           Product[]
  ProductStocks      ProductStock[]
  StockIns           StockIn[]
  StockOuts          StockOut[]
  StockTransfersFrom StockTransfer[]  @relation("TransferFrom")
  StockTransfersTo   StockTransfer[]  @relation("TransferTo")
  StockOpnames       StockOpname[]
  Sales              Sale[]
  Purchases          Purchase[]
  PurchaseOrders     PurchaseOrder[]
  SaleReturns        SaleReturn[]
  PurchaseReturns    PurchaseReturn[]
  SalePoints         SalePoint[]
  TransfersFrom     Transfer[]       @relation("TransferFromWarehouse")
  TransfersTo       Transfer[]        @relation("TransferToWarehouse")
  Productions        Production[]
  Shelves           Shelf[]
  StockMutations    StockMutation[]
  WorkOrders        WorkOrder[]
  Assemblies        Assembly[]
  QCInspections     QCInspection[]
  WorkStations     WorkStation[]
  BOMs             BOM[]
  ProductionRecipeItems ProductionRecipeItem[]
  ProductionRequests ProductionRequest[]
  ProductionSchedules ProductionSchedule[]
  ProductionRequestItems ProductionRequestItem[]

  @@map("Warehouses")
}

// ─── Shelf (Rak) ─────────────────────────────────────────────
model Shelf {
  ID          Int      @id @default(autoincrement())
  WarehouseID Int
  Code        String   @unique @db.VarChar(50)
  Name        String   @db.VarChar(255)
  Description String?  @db.VarChar(500)
  IsActive    Boolean  @default(true)
  CreatedAt   DateTime @default(now())
  UpdatedAt   DateTime @updatedAt

  Warehouse Warehouse @relation(fields: [WarehouseID], references: [ID])
  ShelfProducts ShelfProduct[]

  @@map("Shelves")
}

// ─── ShelfProduct (Produk di Rak) ───────────────────────────
model ShelfProduct {
  ID        Int      @id @default(autoincrement())
  ShelfID   Int
  ProductID Int
  Quantity  Decimal  @default(0) @db.Decimal(15, 3)
  CreatedAt DateTime @default(now())
  UpdatedAt DateTime @updatedAt

  Shelf   Shelf   @relation(fields: [ShelfID], references: [ID], onDelete: Cascade)
  Product Product @relation(fields: [ProductID], references: [ID], onDelete: Cascade)

  @@unique([ShelfID, ProductID])
  @@map("ShelfProducts")
}

// ─── ProductGroup (Golongan Produk) ─────────────────────────
model ProductGroup {
  ID          Int      @id @default(autoincrement())
  Code        String   @unique @db.VarChar(50)
  Name        String   @db.VarChar(255)
  Description String?  @db.VarChar(500)
  IsActive    Boolean  @default(true)
  CreatedAt   DateTime @default(now())
  UpdatedAt   DateTime @updatedAt

  Products Product[]

  @@map("ProductGroups")
}

// ─── ProductType (Tipe Produk) ──────────────────────────────
model ProductType {
  ID          Int      @id @default(autoincrement())
  Name        String   @db.VarChar(255)
  Description String?  @db.VarChar(500)
  IsActive    Boolean  @default(true)
  CreatedAt   DateTime @default(now())
  UpdatedAt   DateTime @updatedAt

  Products Product[]

  @@map("ProductTypes")
}

// ─── Supplier ───────────────────────────────────────────────
model Supplier {
  ID            Int      @id @default(autoincrement())
  Code          String   @unique @db.VarChar(50)
  Name          String   @db.VarChar(255)
  ContactPerson String?  @db.VarChar(255)
  Phone         String?  @db.VarChar(50)
  Email         String?  @db.VarChar(255)
  Address       String?  @db.VarChar(500)
  TotalDebt     Decimal  @default(0) @db.Decimal(15, 2)
  Notes         String?  @db.VarChar(1000)
  IsActive      Boolean  @default(true)
  CreatedAt     DateTime @default(now())
  UpdatedAt     DateTime @updatedAt

  PurchaseOrders   PurchaseOrder[]
  Purchases        Purchase[]
  StockIns         StockIn[]
  SupplierDeposits SupplierDeposit[]
  PurchaseReturns  PurchaseReturn[]
  QCInspections   QCInspection[]
  ProductionRequests ProductionRequest[]

  @@map("Suppliers")
}

// ─── Customer ───────────────────────────────────────────────
model Customer {
  ID              Int           @id @default(autoincrement())
  Code            String        @unique @db.VarChar(50)
  Name            String        @db.VarChar(255)
  Phone           String?       @db.VarChar(50)
  Email           String?       @db.VarChar(255)
  Address         String?       @db.VarChar(500)
  TotalReceivable Decimal       @default(0) @db.Decimal(15, 2)
  CustomerGroupID Int
  PointBalance    Int           @default(0)
  DepositBalance  Decimal       @default(0) @db.Decimal(15, 2)
  Notes           String?       @db.VarChar(1000)
  IsActive        Boolean       @default(true)
  CreatedAt       DateTime      @default(now())
  UpdatedAt       DateTime      @updatedAt

  CustomerGroup   CustomerGroup @relation(fields: [CustomerGroupID], references: [ID])
  Sales            Sale[]
  CustomerDeposits CustomerDeposit[]
  PointRedemptions PointRedemption[]
  SaleReturns      SaleReturn[]
  Services        Service[]
  MemberCards      MemberCard[]

  @@map("Customers")
}

// ─── MemberCardStatus ─────────────────────────────────────────────────────────
model MemberCardStatus {
  ID          Int      @id @default(autoincrement())
  Code        String   @unique @db.VarChar(50)
  Name        String   @db.VarChar(100)
  Description String?  @db.VarChar(500)
  Color       String?  @db.VarChar(50)
  IsActive    Boolean  @default(true)
  SortOrder   Int      @default(0)
  CreatedAt   DateTime @default(now())
  UpdatedAt   DateTime @updatedAt

  MemberCards MemberCard[]

  @@map("MemberCardStatuses")
}

// ─── MemberCard ───────────────────────────────────────────────────────────────
model MemberCard {
  ID              Int       @id @default(autoincrement())
  Code            String    @unique @db.VarChar(50)
  CardNumber      String    @unique @db.VarChar(50)
  CustomerID      Int
  CardType        String    @default("STANDARD") @db.VarChar(50)
  Balance         Decimal   @default(0) @db.Decimal(15, 2)
  MinimumBalance  Decimal   @default(0) @db.Decimal(15, 2)
  StatusID        Int       @default(1)
  ReplacedFromID  Int?
  Notes           String?   @db.VarChar(1000)
  IsActive        Boolean   @default(true)
  CreatedAt       DateTime  @default(now())
  UpdatedAt       DateTime  @updatedAt

  Customer       Customer          @relation(fields: [CustomerID], references: [ID])
  Status        MemberCardStatus @relation(fields: [StatusID], references: [ID])
  ReplacedFrom  MemberCard?     @relation("CardReplacement", fields: [ReplacedFromID], references: [ID])
  ReplacedCards MemberCard[]    @relation("CardReplacement")
  Transactions  MemberCardTransaction[]

  @@map("MemberCards")
}

// ─── MemberCardTransaction ────────────────────────────────────────────────────
model MemberCardTransaction {
  ID              Int       @id @default(autoincrement())
  MemberCardID    Int
  TransactionType String    @db.VarChar(50)
  Amount          Decimal   @db.Decimal(15, 2)
  BalanceBefore   Decimal   @default(0) @db.Decimal(15, 2)
  BalanceAfter    Decimal   @default(0) @db.Decimal(15, 2)
  ReferenceNumber String?   @db.VarChar(100)
  Notes           String?   @db.VarChar(1000)
  CreatedByID     String?
  CreatedAt       DateTime  @default(now())

  MemberCard MemberCard @relation(fields: [MemberCardID], references: [ID], onDelete: Cascade)
  Creator    User?      @relation(fields: [CreatedByID], references: [ID])

  @@map("MemberCardTransactions")
}

// ─── SalesPerson ──────────────────────────────────────────
model SalesPerson {
  ID        Int      @id @default(autoincrement())
  Code      String   @unique @db.VarChar(50)
  Name      String   @db.VarChar(255)
  Phone     String?  @db.VarChar(50)
  Email     String?  @db.VarChar(255)
  Address   String?  @db.VarChar(500)
  IsActive  Boolean  @default(true)
  CreatedAt DateTime @default(now())
  UpdatedAt DateTime @updatedAt

  Sales Sale[]

  @@map("SalesPersons")
}

// ─── SalePoint ─────────────────────────────────────────────
model SalePoint {
  ID          Int      @id @default(autoincrement())
  Code        String   @unique @db.VarChar(50)
  Name        String   @db.VarChar(255)
  WarehouseID Int?
  Description String?  @db.VarChar(500)
  IsActive    Boolean  @default(true)
  CreatedAt   DateTime @default(now())
  UpdatedAt   DateTime @updatedAt

  Warehouse Warehouse? @relation(fields: [WarehouseID], references: [ID])
  Sales     Sale[]

  @@map("SalePoints")
}

// ─── Product ────────────────────────────────────────────────
model Product {
  ID              Int      @id @default(autoincrement())
  Code            String   @unique @db.VarChar(50)
  Barcode         String?  @db.VarChar(100)
  Name            String   @db.VarChar(255)
  CategoryID      Int?
  BrandID         Int?
  ProductTypeID   Int?
  UnitID          Int
  WarehouseID     Int?
  PurchasePrice   Decimal  @default(0) @db.Decimal(15, 2)
  SellingPrice    Decimal  @default(0) @db.Decimal(15, 2)
  DiscountPercent Decimal  @default(0) @db.Decimal(5, 2)
  Stock           Decimal  @default(0) @db.Decimal(15, 3)
  MinimumStock    Decimal  @default(0) @db.Decimal(15, 3)
  Image           String?  @db.VarChar(500)
  Description     String?  @db.VarChar(1000)
  IsActive        Boolean  @default(true)
  CreatedAt       DateTime @default(now())
  UpdatedAt       DateTime @updatedAt

  Category     Category?     @relation(fields: [CategoryID], references: [ID])
  Brand        Brand?        @relation(fields: [BrandID], references: [ID])
  ProductType  ProductType?  @relation(fields: [ProductTypeID], references: [ID])
  Unit         Unit          @relation(fields: [UnitID], references: [ID])
  Warehouse    Warehouse?    @relation(fields: [WarehouseID], references: [ID])

  // Relations
  PurchaseOrderItems  PurchaseOrderItem[]
  PurchaseItems       PurchaseItem[]
  PurchaseReturnItems PurchaseReturnItem[]
  StockInItems        StockInItem[]
  StockOutItems       StockOutItem[]
  StockTransferItems  StockTransferItem[]
  StockOpnameItems    StockOpnameItem[]
  SaleItems           SaleItem[]
  SaleReturnItems     SaleReturnItem[]
  ProductStocks       ProductStock[]
  PriceHistories      PriceHistory[]
  ProductPrices       ProductPrice[]
  ServiceItems        ServiceItem[]
  ProductionItems     ProductionItem[]
  Productions         Production[]
  ProductImages       ProductImage[]
  ProductBarcodes     ProductBarcode[]
  StockAlerts         StockAlert[]
  ProductGroupID      Int?
  ProductGroup        ProductGroup? @relation(fields: [ProductGroupID], references: [ID])
  ShelfProducts       ShelfProduct[]
  StockMutationItems  StockMutationItem[]
  PackageItems        PackageItem[]
  QCInspectionItems   QCInspectionItem[]
  QCStandards         QCStandard[]
  WorkOrderItems      WorkOrderItem[]
  DefectReports       DefectReport[]
  ProgressRecords     ProgressRecord[]
  MaterialAllocations MaterialAllocation[]
  AssemblyComponents AssemblyComponent[]
  BOMItems          BOMItem[]
  BOMs              BOM[]
  ProductUnits       ProductUnit[]
  ProductionRecipes  ProductionRecipe[]
  ProductionRecipeItems ProductionRecipeItem[]
  ProductionRequests ProductionRequest[]
  ProductionSchedules ProductionSchedule[]
  ProductionRequestItems ProductionRequestItem[]

  @@map("Products")
}

// ─── ProductStock (per warehouse) ────────────────────────────
model ProductStock {
  ID           Int      @id @default(autoincrement())
  ProductID    Int
  WarehouseID  Int
  Quantity     Decimal  @default(0) @db.Decimal(15, 3)
  MinimumStock Decimal  @default(0) @db.Decimal(15, 3)
  UpdatedAt    DateTime @updatedAt

  Product   Product   @relation(fields: [ProductID], references: [ID], onDelete: Cascade)
  Warehouse Warehouse @relation(fields: [WarehouseID], references: [ID], onDelete: Cascade)

  @@unique([ProductID, WarehouseID])
  @@map("ProductStocks")
}

// ─── ProductUnit (Unit konversi per produk) ─────────────────
model ProductUnit {
  ID              Int      @id @default(autoincrement())
  ProductID      Int
  UnitID         Int
  IsBase         Boolean  @default(false)
  ConversionValue Decimal @default(1) @db.Decimal(15, 6)
  IsPrimary      Boolean  @default(false)
  IsSell         Boolean  @default(true)
  IsPurchase     Boolean  @default(true)
  CreatedAt      DateTime @default(now())
  UpdatedAt      DateTime @updatedAt

  Product Product @relation(fields: [ProductID], references: [ID], onDelete: Cascade)
  Unit    Unit    @relation(fields: [UnitID], references: [ID])

  @@unique([ProductID, UnitID])
  @@map("ProductUnits")
}

// ═══════════════════════════════════════════════════════════════════════════════
// SALE TRANSACTIONS
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Sale ───────────────────────────────────────────────────
model Sale {
  ID              Int            @id @default(autoincrement())
  Code            String         @unique @db.VarChar(50)
  Date            DateTime       @default(now())
  CustomerID      Int
  SalesPersonID   Int?
  SalePointID     Int?
  WarehouseID     Int?
  Subtotal        Decimal        @default(0) @db.Decimal(15, 2)
  DiscountPercent Decimal        @default(0) @db.Decimal(5, 2)
  DiscountAmount  Decimal        @default(0) @db.Decimal(15, 2)
  TaxPercent      Decimal        @default(0) @db.Decimal(5, 2)
  TaxAmount       Decimal        @default(0) @db.Decimal(15, 2)
  Total           Decimal        @default(0) @db.Decimal(15, 2)
  CashAmount      Decimal        @default(0) @db.Decimal(15, 2)
  ChangeAmount    Decimal        @default(0) @db.Decimal(15, 2)
  PaymentStatusID Int
  IsReturn        Boolean        @default(false)
  ReturnedAt      DateTime?
  PaymentMethodID Int?
  Notes           String?        @db.VarChar(1000)
  ShippingStatus  String?        @default("PENDING") @db.VarChar(20)
  ShippingDate    DateTime?
  TrackingNumber  String?        @db.VarChar(100)
  CreatedByID     String
  CreatedAt       DateTime       @default(now())
  UpdatedAt       DateTime       @updatedAt

  Customer      Customer        @relation(fields: [CustomerID], references: [ID])
  SalesPerson   SalesPerson?    @relation(fields: [SalesPersonID], references: [ID])
  SalePoint     SalePoint?       @relation(fields: [SalePointID], references: [ID])
  Warehouse     Warehouse?       @relation(fields: [WarehouseID], references: [ID])
  Creator       User            @relation(fields: [CreatedByID], references: [ID])
  PaymentStatus PaymentStatus   @relation(fields: [PaymentStatusID], references: [ID])
  PaymentMethod PaymentMethod?  @relation(fields: [PaymentMethodID], references: [ID])

  SaleItems    SaleItem[]
  SalePayments SalePayment[]
  SaleReturns  SaleReturn[]
  DefectReports DefectReport[]
  CashFlowTransactions CashFlowTransaction[]

  @@map("Sales")
}

// ─── SaleItem ──────────────────────────────────────────────
model SaleItem {
  ID              Int      @id @default(autoincrement())
  SaleID          Int
  ProductID       Int
  Quantity        Decimal  @db.Decimal(15, 3)
  UnitPrice       Decimal  @db.Decimal(15, 2)
  DiscountPercent Decimal  @default(0) @db.Decimal(5, 2)
  DiscountAmount  Decimal  @default(0) @db.Decimal(15, 2)
  Subtotal        Decimal  @db.Decimal(15, 2)
  CreatedAt       DateTime @default(now())

  Sale    Sale    @relation(fields: [SaleID], references: [ID], onDelete: Cascade)
  Product Product @relation(fields: [ProductID], references: [ID])
  Unit    Unit?   @relation(fields: [UnitID], references: [ID])
  UnitID  Int?

  @@map("SaleItems")
}

// ─── SalePayment ────────────────────────────────────────────
model SalePayment {
  ID              Int            @id @default(autoincrement())
  SaleID          Int
  MethodID        Int
  Amount          Decimal       @db.Decimal(15, 2)
  ReferenceNumber String?       @db.VarChar(100)
  Date            DateTime      @default(now())
  Notes           String?       @db.VarChar(500)
  CreatedByID     String
  CreatedAt       DateTime      @default(now())

  Sale    Sale           @relation(fields: [SaleID], references: [ID], onDelete: Cascade)
  Method  PaymentMethod @relation(fields: [MethodID], references: [ID])
  Creator User           @relation(fields: [CreatedByID], references: [ID])

  @@map("SalePayments")
}

// ─── SaleReturn ────────────────────────────────────────────
model SaleReturn {
  ID          Int               @id @default(autoincrement())
  Code        String            @unique @db.VarChar(50)
  Date        DateTime          @default(now())
  SaleID      Int
  CustomerID  Int
  WarehouseID Int?
  TotalReturn Decimal           @db.Decimal(15, 2)
  Reason      String?           @db.VarChar(1000)
  StatusID    Int               @default(1)
  CreatedByID String
  CreatedAt   DateTime          @default(now())
  UpdatedAt   DateTime          @updatedAt

  Sale      Sale               @relation(fields: [SaleID], references: [ID])
  Customer  Customer           @relation(fields: [CustomerID], references: [ID])
  Warehouse Warehouse?          @relation(fields: [WarehouseID], references: [ID])
  Creator   User              @relation(fields: [CreatedByID], references: [ID])
  Status    TransactionStatus   @relation(fields: [StatusID], references: [ID])

  ReturnItems SaleReturnItem[]

  @@map("SaleReturns")
}

// ─── SaleReturnItem ───────────────────────────────────────
model SaleReturnItem {
  ID           Int      @id @default(autoincrement())
  SaleReturnID Int
  ProductID    Int
  Quantity     Decimal  @db.Decimal(15, 3)
  UnitPrice    Decimal  @db.Decimal(15, 2)
  Subtotal     Decimal  @db.Decimal(15, 2)
  CreatedAt    DateTime @default(now())

  SaleReturn SaleReturn @relation(fields: [SaleReturnID], references: [ID], onDelete: Cascade)
  Product    Product    @relation(fields: [ProductID], references: [ID])
  Unit       Unit?      @relation(fields: [UnitID], references: [ID])
  UnitID     Int?

  @@map("SaleReturnItems")
}

// ═══════════════════════════════════════════════════════════════════════════════
// PURCHASE TRANSACTIONS
// ═══════════════════════════════════════════════════════════════════════════════

// ─── PurchaseOrder ─────────────────────────────────────────
model PurchaseOrder {
  ID              Int               @id @default(autoincrement())
  Code            String            @unique @db.VarChar(50)
  Date            DateTime          @default(now())
  SupplierID      Int
  WarehouseID     Int?
  Subtotal        Decimal           @default(0) @db.Decimal(15, 2)
  DiscountPercent Decimal           @default(0) @db.Decimal(5, 2)
  DiscountAmount  Decimal           @default(0) @db.Decimal(15, 2)
  TaxPercent      Decimal           @default(0) @db.Decimal(5, 2)
  TaxAmount       Decimal           @default(0) @db.Decimal(15, 2)
  Total           Decimal           @default(0) @db.Decimal(15, 2)
  DownPayment     Decimal           @default(0) @db.Decimal(15, 2)
  PaymentStatusID Int
  DueDate         DateTime?
  IsInvoice       Boolean           @default(false)
  PurchaseID      Int?
  StatusID        Int               @default(1)
  Notes           String?           @db.VarChar(1000)
  CreatedByID     String
  CreatedAt       DateTime          @default(now())
  UpdatedAt       DateTime          @updatedAt

  Supplier       Supplier         @relation(fields: [SupplierID], references: [ID])
  Warehouse       Warehouse?       @relation(fields: [WarehouseID], references: [ID])
  Creator         User            @relation(fields: [CreatedByID], references: [ID])
  PaymentStatus   PaymentStatus   @relation(fields: [PaymentStatusID], references: [ID])
  Status         TransactionStatus @relation(fields: [StatusID], references: [ID])

  PurchaseOrderItems PurchaseOrderItem[]
  Purchases        Purchase[]

  @@map("PurchaseOrders")
}

// ─── PurchaseOrderItem ────────────────────────────────────
model PurchaseOrderItem {
  ID              Int      @id @default(autoincrement())
  PurchaseOrderID Int
  ProductID       Int
  Quantity        Decimal  @db.Decimal(15, 3)
  UnitID          Int
  UnitPrice       Decimal  @db.Decimal(15, 2)
  DiscountPercent Decimal  @default(0) @db.Decimal(5, 2)
  DiscountAmount  Decimal  @default(0) @db.Decimal(15, 2)
  Subtotal        Decimal  @db.Decimal(15, 2)
  CreatedAt       DateTime @default(now())

  PurchaseOrder PurchaseOrder @relation(fields: [PurchaseOrderID], references: [ID], onDelete: Cascade)
  Product       Product       @relation(fields: [ProductID], references: [ID])
  Unit          Unit          @relation(fields: [UnitID], references: [ID])

  @@map("PurchaseOrderItems")
}

// ─── Purchase ───────────────────────────────────────────────
model Purchase {
  ID              Int               @id @default(autoincrement())
  Code            String            @unique @db.VarChar(50)
  Date            DateTime          @default(now())
  SupplierID      Int
  WarehouseID     Int?
  PurchaseOrderId Int?
  Subtotal        Decimal           @default(0) @db.Decimal(15, 2)
  DiscountPercent Decimal           @default(0) @db.Decimal(5, 2)
  DiscountAmount  Decimal           @default(0) @db.Decimal(15, 2)
  TaxPercent      Decimal           @default(0) @db.Decimal(5, 2)
  TaxAmount       Decimal           @default(0) @db.Decimal(15, 2)
  Total           Decimal           @default(0) @db.Decimal(15, 2)
  Paid            Decimal           @default(0) @db.Decimal(15, 2)
  Remaining       Decimal           @default(0) @db.Decimal(15, 2)
  PaymentStatusID Int
  PaymentMethodID Int?
  DueDate         DateTime?
  IsReturn        Boolean           @default(false)
  StatusID        Int               @default(1)
  Notes           String?           @db.VarChar(1000)
  CreatedByID     String
  CreatedAt       DateTime          @default(now())
  UpdatedAt       DateTime          @updatedAt

  Supplier       Supplier         @relation(fields: [SupplierID], references: [ID])
  Warehouse       Warehouse?       @relation(fields: [WarehouseID], references: [ID])
  PurchaseOrder   PurchaseOrder?   @relation(fields: [PurchaseOrderId], references: [ID])
  Creator         User            @relation(fields: [CreatedByID], references: [ID])
  PaymentStatus   PaymentStatus   @relation(fields: [PaymentStatusID], references: [ID])
  PaymentMethod   PaymentMethod?  @relation(fields: [PaymentMethodID], references: [ID])
  Status         TransactionStatus @relation(fields: [StatusID], references: [ID])

  PurchaseItems    PurchaseItem[]
  PurchasePayments PurchasePayment[]
  PurchaseReturns  PurchaseReturn[]

  @@map("Purchases")
}

// ─── PurchaseItem ──────────────────────────────────────────
model PurchaseItem {
  ID              Int      @id @default(autoincrement())
  PurchaseID      Int
  ProductID       Int
  Quantity        Decimal  @db.Decimal(15, 3)
  UnitID          Int
  UnitPrice       Decimal  @db.Decimal(15, 2)
  DiscountPercent Decimal  @default(0) @db.Decimal(5, 2)
  DiscountAmount  Decimal  @default(0) @db.Decimal(15, 2)
  Subtotal        Decimal  @db.Decimal(15, 2)
  CreatedAt       DateTime @default(now())

  Purchase Purchase @relation(fields: [PurchaseID], references: [ID], onDelete: Cascade)
  Product  Product  @relation(fields: [ProductID], references: [ID])
  Unit     Unit     @relation(fields: [UnitID], references: [ID])

  @@map("PurchaseItems")
}

// ─── PurchasePayment ───────────────────────────────────────
model PurchasePayment {
  ID              Int            @id @default(autoincrement())
  PurchaseID      Int
  MethodID        Int
  Amount          Decimal       @db.Decimal(15, 2)
  ReferenceNumber String?       @db.VarChar(100)
  Date            DateTime      @default(now())
  Notes           String?       @db.VarChar(500)
  CreatedByID     String
  CreatedAt       DateTime      @default(now())

  Purchase Purchase       @relation(fields: [PurchaseID], references: [ID], onDelete: Cascade)
  Method   PaymentMethod  @relation(fields: [MethodID], references: [ID])
  Creator  User           @relation(fields: [CreatedByID], references: [ID])

  @@map("PurchasePayments")
}

// ─── PurchaseReturn ────────────────────────────────────────
model PurchaseReturn {
  ID          Int               @id @default(autoincrement())
  Code        String            @unique @db.VarChar(50)
  Date        DateTime          @default(now())
  PurchaseID  Int
  SupplierID  Int
  WarehouseID Int?
  TotalReturn Decimal           @db.Decimal(15, 2)
  Reason      String?           @db.VarChar(1000)
  StatusID    Int               @default(1)
  CreatedByID String
  CreatedAt   DateTime          @default(now())
  UpdatedAt   DateTime          @updatedAt

  Purchase  Purchase         @relation(fields: [PurchaseID], references: [ID])
  Supplier  Supplier         @relation(fields: [SupplierID], references: [ID])
  Warehouse Warehouse?        @relation(fields: [WarehouseID], references: [ID])
  Creator   User            @relation(fields: [CreatedByID], references: [ID])
  Status    TransactionStatus @relation(fields: [StatusID], references: [ID])

  ReturnItems PurchaseReturnItem[]

  @@map("PurchaseReturns")
}

// ─── PurchaseReturnItem ───────────────────────────────────
model PurchaseReturnItem {
  ID               Int      @id @default(autoincrement())
  PurchaseReturnID Int
  ProductID        Int
  Quantity         Decimal  @db.Decimal(15, 3)
  UnitID           Int
  UnitPrice        Decimal  @db.Decimal(15, 2)
  Subtotal         Decimal  @db.Decimal(15, 2)
  CreatedAt        DateTime @default(now())

  PurchaseReturn PurchaseReturn @relation(fields: [PurchaseReturnID], references: [ID], onDelete: Cascade)
  Product        Product        @relation(fields: [ProductID], references: [ID])
  Unit           Unit           @relation(fields: [UnitID], references: [ID])

  @@map("PurchaseReturnItems")
}

