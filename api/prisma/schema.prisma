// ─── StockOutItem ──────────────────────────────────────────
model StockOutItem {
  ID         Int      @id @default(autoincrement())
  StockOutID Int
  ProductID  Int
  Quantity   Decimal  @db.Decimal(15, 3)
  UnitID     Int
  UnitPrice  Decimal  @default(0) @db.Decimal(15, 2)
  Subtotal   Decimal  @default(0) @db.Decimal(15, 2)
  CreatedAt  DateTime @default(now())

  StockOut StockOut @relation(fields: [StockOutID], references: [ID], onDelete: Cascade)
  Product  Product  @relation(fields: [ProductID], references: [ID])
  Unit     Unit     @relation(fields: [UnitID], references: [ID])

  @@map("StockOutItems")
}

// ─── StockTransfer ──────────────────────────────────────────
model StockTransfer {
  ID              Int               @id @default(autoincrement())
  Code            String            @unique @db.VarChar(50)
  Date            DateTime          @default(now())
  FromWarehouseID Int
  ToWarehouseID   Int
  TotalItems      Decimal           @default(0) @db.Decimal(15, 2)
  StatusID        Int               @default(1)
  Notes           String?           @db.VarChar(1000)
  CreatedByID     String
  CreatedAt       DateTime          @default(now())
  UpdatedAt       DateTime          @updatedAt

  FromWarehouse Warehouse        @relation("TransferFrom", fields: [FromWarehouseID], references: [ID])
  ToWarehouse   Warehouse        @relation("TransferTo", fields: [ToWarehouseID], references: [ID])
  Creator       User             @relation(fields: [CreatedByID], references: [ID])
  Status        TransactionStatus @relation(fields: [StatusID], references: [ID])

  TransferItems StockTransferItem[]

  @@map("StockTransfers")
}

// ─── StockTransferItem ─────────────────────────────────────
model StockTransferItem {
  ID              Int      @id @default(autoincrement())
  StockTransferID Int
  ProductID       Int
  Quantity        Decimal  @db.Decimal(15, 3)
  UnitID          Int
  UnitPrice       Decimal  @default(0) @db.Decimal(15, 2)
  Subtotal        Decimal  @default(0) @db.Decimal(15, 2)
  CreatedAt       DateTime @default(now())

  StockTransfer StockTransfer @relation(fields: [StockTransferID], references: [ID], onDelete: Cascade)
  Product       Product       @relation(fields: [ProductID], references: [ID])
  Unit          Unit          @relation(fields: [UnitID], references: [ID])

  @@map("StockTransferItems")
}

// ─── StockOpname ────────────────────────────────────────────
model StockOpname {
  ID          Int               @id @default(autoincrement())
  Code        String            @unique @db.VarChar(50)
  Date        DateTime          @default(now())
  WarehouseID Int
  TotalItems  Decimal           @default(0) @db.Decimal(15, 2)
  StatusID    Int               @default(1)
  Notes       String?           @db.VarChar(1000)
  CreatedByID String
  CreatedAt   DateTime          @default(now())
  UpdatedAt   DateTime          @updatedAt

  Warehouse Warehouse         @relation(fields: [WarehouseID], references: [ID])
  Creator   User              @relation(fields: [CreatedByID], references: [ID])
  Status   StockOpnameStatus @relation(fields: [StatusID], references: [ID])

  OpnameItems StockOpnameItem[]

  @@map("StockOpnames")
}

// ─── StockOpnameItem ───────────────────────────────────────
model StockOpnameItem {
  ID            Int      @id @default(autoincrement())
  StockOpnameID Int
  ProductID     Int
  SystemStock   Decimal  @db.Decimal(15, 3)
  CountedStock  Decimal  @db.Decimal(15, 3)
  Difference    Decimal  @db.Decimal(15, 3)
  UnitID        Int
  UnitPrice     Decimal  @default(0) @db.Decimal(15, 2)
  Note          String?  @db.VarChar(500)
  CreatedAt     DateTime @default(now())

  StockOpname StockOpname @relation(fields: [StockOpnameID], references: [ID], onDelete: Cascade)
  Product     Product     @relation(fields: [ProductID], references: [ID])
  Unit        Unit        @relation(fields: [UnitID], references: [ID])

  @@map("StockOpnameItems")
}

// ═══════════════════════════════════════════════════════════════════════════════
// ACCOUNTING
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Account ────────────────────────────────────────────────
model Account {
  ID        Int         @id @default(autoincrement())
  Code      String      @unique @db.VarChar(50)
  Name      String      @db.VarChar(255)
  TypeID    Int
  ParentID  Int?
  Balance   Decimal     @default(0) @db.Decimal(15, 2)
  IsActive  Boolean     @default(true)
  CreatedAt DateTime    @default(now())
  UpdatedAt DateTime    @updatedAt

  Parent   Account?  @relation("AccountParent", fields: [ParentID], references: [ID])
  Children Account[] @relation("AccountParent")
  Type     AccountType @relation(fields: [TypeID], references: [ID])

  // Accounting relations
  CashIns           CashIn[]
  CashOuts          CashOut[]
  CashTransfersFrom CashTransfer[] @relation("CashTransferFrom")
  CashTransfersTo   CashTransfer[] @relation("CashTransferTo")
  JournalEntryLines JournalEntryLine[]
  CashFlowTransactions CashFlowTransaction[]
  TransfersFrom    Transfer[]      @relation("TransferFromAccount")
  TransfersTo      Transfer[]      @relation("TransferToAccount")
  Extension        AccountExtension?

  @@map("Accounts")
}

// ─── Journal ─────────────────────────────────────────────────
model Journal {
  ID            Int       @id @default(autoincrement())
  Code          String    @unique @db.VarChar(50)
  Date          DateTime  @default(now())
  Description   String?   @db.VarChar(1000)
  ReferenceType String?   @db.VarChar(100)
  ReferenceID   Int?
  IsPosted      Boolean   @default(false)
  PostedAt      DateTime?
  CreatedByID   String
  CreatedAt     DateTime  @default(now())
  UpdatedAt     DateTime  @updatedAt

  Creator User @relation(fields: [CreatedByID], references: [ID])

  JournalEntries JournalEntry[]

  @@map("Journals")
}

// ─── JournalEntry ───────────────────────────────────────────
model JournalEntry {
  ID                  Int       @id @default(autoincrement())
  JournalNumber       String    @unique @db.VarChar(50)
  Date               DateTime  @default(now())
  Type               String    @default("GENERAL") @db.VarChar(50)
  Reference          String?   @db.VarChar(100)
  ReferenceType      String?   @db.VarChar(100)
  ReferenceID        Int?
  ReferenceNumber    String?   @db.VarChar(100)
  Description        String?   @db.VarChar(1000)
  Notes              String?   @db.VarChar(1000)
  SourceDocumentID   Int?
  SourceDocumentType  String?   @db.VarChar(100)
  TotalDebit         Decimal   @default(0) @db.Decimal(15, 2)
  TotalCredit        Decimal   @default(0) @db.Decimal(15, 2)
  Status             String    @default("DRAFT") @db.VarChar(20)
  ReversedEntryID    Int?
  CreatedByID        String
  CreatedAt          DateTime  @default(now())
  UpdatedAt          DateTime  @updatedAt

  Journal         Journal?        @relation(fields: [JournalID], references: [ID])
  JournalID      Int?
  ReversedEntry  JournalEntry?   @relation("Reversal", fields: [ReversedEntryID], references: [ID])
  Reversals      JournalEntry[]   @relation("Reversal")
  Creator        User             @relation(fields: [CreatedByID], references: [ID])

  Lines JournalEntryLine[]
  ClosingEntries ClosingEntry[]

  @@map("JournalEntries")
}

// ─── CashIn ─────────────────────────────────────────────────
model CashIn {
  ID            Int      @id @default(autoincrement())
  Code          String   @unique @db.VarChar(50)
  Date          DateTime @default(now())
  AccountID     Int
  Amount        Decimal  @db.Decimal(15, 2)
  Description   String?  @db.VarChar(1000)
  ReferenceType String?  @db.VarChar(100)
  ReferenceID   Int?
  CreatedByID   String
  CreatedAt     DateTime @default(now())
  UpdatedAt     DateTime @updatedAt

  Account Account @relation(fields: [AccountID], references: [ID])
  Creator User    @relation(fields: [CreatedByID], references: [ID])

  @@map("CashIns")
}

// ─── CashOut ────────────────────────────────────────────────
model CashOut {
  ID            Int      @id @default(autoincrement())
  Code          String   @unique @db.VarChar(50)
  Date          DateTime @default(now())
  AccountID     Int
  Amount        Decimal  @db.Decimal(15, 2)
  Description   String?  @db.VarChar(1000)
  ReferenceType String?  @db.VarChar(100)
  ReferenceID   Int?
  CreatedByID   String
  CreatedAt     DateTime @default(now())
  UpdatedAt     DateTime @updatedAt

  Account Account @relation(fields: [AccountID], references: [ID])
  Creator User    @relation(fields: [CreatedByID], references: [ID])

  @@map("CashOuts")
}

// ─── CashTransfer ───────────────────────────────────────────
model CashTransfer {
  ID            Int      @id @default(autoincrement())
  Code          String   @unique @db.VarChar(50)
  Date          DateTime @default(now())
  FromAccountID Int
  ToAccountID   Int
  Amount        Decimal  @db.Decimal(15, 2)
  Description   String?  @db.VarChar(1000)
  CreatedByID   String
  CreatedAt     DateTime @default(now())
  UpdatedAt     DateTime @updatedAt

  FromAccount Account @relation("CashTransferFrom", fields: [FromAccountID], references: [ID])
  ToAccount   Account @relation("CashTransferTo", fields: [ToAccountID], references: [ID])
  Creator     User    @relation(fields: [CreatedByID], references: [ID])

  @@map("CashTransfers")
}

// ─── CustomerDeposit ────────────────────────────────────────
model CustomerDeposit {
  ID              Int      @id @default(autoincrement())
  Code            String   @unique @db.VarChar(50)
  Date            DateTime @default(now())
  CustomerID      Int
  Amount          Decimal  @db.Decimal(15, 2)
  RemainingAmount Decimal  @db.Decimal(15, 2)
  ReferenceNumber String?  @db.VarChar(100)
  Type            String   @default("DEPOSIT") @db.VarChar(50)
  PaymentMethodID Int?
  Description     String?  @db.VarChar(1000)
  CreatedByID    String?
  CreatedAt      DateTime @default(now())
  UpdatedAt      DateTime @updatedAt

  Customer      Customer      @relation(fields: [CustomerID], references: [ID])
  Creator       User?         @relation(fields: [CreatedByID], references: [ID])
  PaymentMethod PaymentMethod? @relation(fields: [PaymentMethodID], references: [ID])

  @@map("CustomerDeposits")
}

// ─── SupplierDeposit ────────────────────────────────────────
model SupplierDeposit {
  ID              Int      @id @default(autoincrement())
  Code            String   @unique @db.VarChar(50)
  Date            DateTime @default(now())
  SupplierID      Int
  Amount          Decimal  @db.Decimal(15, 2)
  RemainingAmount Decimal  @db.Decimal(15, 2)
  Description     String?  @db.VarChar(1000)
  CreatedByID     String
  CreatedAt       DateTime @default(now())
  UpdatedAt       DateTime @updatedAt

  Supplier Supplier @relation(fields: [SupplierID], references: [ID])
  Creator  User     @relation(fields: [CreatedByID], references: [ID])

  @@map("SupplierDeposits")
}

// ═══════════════════════════════════════════════════════════════════════════════
// POINT SYSTEM & SETTINGS
// ═══════════════════════════════════════════════════════════════════════════════

model PointSetting {
  ID                 Int      @id @default(autoincrement())
  Name               String   @db.VarChar(255)
  PointsPerRupiah    Decimal  @db.Decimal(10, 4)
  MinimumTransaction Decimal  @db.Decimal(15, 2)
  IsActive           Boolean  @default(true)
  CreatedAt          DateTime @default(now())
  UpdatedAt          DateTime @updatedAt

  @@map("PointSettings")
}

model PointRedemption {
  ID             Int      @id @default(autoincrement())
  CustomerID     Int
  Code           String   @unique @db.VarChar(50)
  PointsRedeemed Int
  RewardName     String   @db.VarChar(255)
  RewardValue    Decimal  @db.Decimal(15, 2)
  Date           DateTime @default(now())
  CreatedByID    String
  CreatedAt      DateTime @default(now())

  Customer Customer @relation(fields: [CustomerID], references: [ID])
  Creator  User     @relation(fields: [CreatedByID], references: [ID])

  @@map("PointRedemptions")
}

// ─── Company Settings ────────────────────────────────────────
model Company {
  ID          Int      @id @default(autoincrement())
  CompanyCode String   @unique @db.VarChar(50)
  Name        String   @db.VarChar(255)
  Address     String?  @db.VarChar(500)
  Phone       String?  @db.VarChar(50)
  Email       String?  @db.VarChar(255)
  City        String?  @db.VarChar(100)
  Province    String?  @db.VarChar(100)
  PostalCode  String?  @db.VarChar(20)
  TaxID       String?  @db.VarChar(50)
  LogoUrl     String?  @db.VarChar(500)
  IsActive    Boolean  @default(true)
  CreatedAt   DateTime @default(now())
  UpdatedAt   DateTime @updatedAt

  Users       User[]

  @@map("Companies")
}

// ─── AppSetting (Pengaturan Umum/Transaksi/Desimal) ──────────────────
model AppSetting {
  ID                      Int      @id @default(autoincrement())
  ReportDesignEnabled     Boolean  @default(false)
  ItemAddMode             String   @default("SEDANG") @db.VarChar(50)
  DisplayMode             String   @default("ACTIVE_ONLY") @db.VarChar(50)
  DisplayRowMode          String   @default("SINGLE_ROW") @db.VarChar(50)
  Timezone                String   @default("Asia/Jakarta") @db.VarChar(100)
  MaxSearchRows           Int      @default(100)
  AddressBinding          String   @default("COMPANY") @db.VarChar(50)
  ShowImageOnTransaction  Boolean  @default(true)
  WarnPriceBelowCost      Boolean  @default(true)
  ShowBrandColumn         Boolean  @default(false)
  ShowInfoColumn          Boolean  @default(false)
  EditRequiresAccess      Boolean  @default(false)
  AutoShowSalesOnCustomer Boolean  @default(false)
  DecimalPrice            Int      @default(0)
  DecimalQty              Int      @default(0)
  DecimalTax              Int      @default(0)
  DecimalDiscount         Int      @default(0)
  CreatedAt               DateTime @default(now())
  UpdatedAt               DateTime @updatedAt

  @@map("AppSettings")
}

// ─── NumberingFormat ───────────────────────────────────────
model Numbering {
  ID         Int      @id @default(autoincrement())
  Type       String   @unique @db.VarChar(100)
  Prefix     String   @default("") @db.VarChar(20)
  LastNumber Int      @default(0)
  Suffix     String   @default("") @db.VarChar(20)
  DigitCount Int      @default(4)
  IsActive   Boolean  @default(true)
  CreatedAt  DateTime @default(now())
  UpdatedAt  DateTime @updatedAt

  @@map("Numberings")
}

model Testing {
  ID        Int      @id @default(autoincrement())
  Type      String   @unique @db.VarChar(100)
  IsActive  Boolean  @default(true)
  CreatedAt DateTime @default(now())
  UpdatedAt DateTime @updatedAt

  @@map("Testings")
}

// ═══════════════════════════════════════════════════════════════════════════════
// EXPENSE MANAGEMENT
// ═══════════════════════════════════════════════════════════════════════════════

// ─── ExpenseCategory ─────────────────────────────────────────
model ExpenseCategory {
  ID          Int       @id @default(autoincrement())
  Code        String    @unique @db.VarChar(50)
  Name        String    @db.VarChar(255)
  Description String?   @db.VarChar(1000)
  IsActive    Boolean   @default(true)
  CreatedAt   DateTime  @default(now())
  UpdatedAt   DateTime  @updatedAt

  Expenses Expense[]

  @@map("ExpenseCategories")
}

// ─── Expense ───────────────────────────────────────────────────
model Expense {
  ID              Int       @id @default(autoincrement())
  Code            String    @unique @db.VarChar(50)
  Date            DateTime  @default(now())
  ExpenseCategoryID Int
  Amount          Decimal   @db.Decimal(15, 2)
  Description     String?   @db.VarChar(1000)
  ReferenceNumber String?   @db.VarChar(100)
  IsApproved      Boolean   @default(false)
  ApprovedByID    String?
  ApprovedAt      DateTime?
  Notes           String?   @db.VarChar(1000)
  IsActive        Boolean   @default(true)
  CreatedAt       DateTime  @default(now())
  UpdatedAt       DateTime  @updatedAt

  ExpenseCategory ExpenseCategory @relation(fields: [ExpenseCategoryID], references: [ID])
  Approver       User?          @relation(fields: [ApprovedByID], references: [ID])

  @@map("Expenses")
}

// ─── Transfer ──────────────────────────────────────────────────
model Transfer {
  ID            Int               @id @default(autoincrement())
  Code          String            @unique @db.VarChar(50)
  Date          DateTime          @default(now())
  FromAccountID Int?
  ToAccountID   Int?
  FromWarehouseID Int?
  ToWarehouseID Int?
  Amount        Decimal           @db.Decimal(15, 2)
  Description   String?           @db.VarChar(1000)
  StatusID      Int               @default(1)
  Notes         String?           @db.VarChar(1000)
  IsActive      Boolean           @default(true)
  CreatedAt     DateTime          @default(now())
  UpdatedAt     DateTime          @updatedAt

  FromAccount   Account?   @relation("TransferFromAccount", fields: [FromAccountID], references: [ID])
  ToAccount     Account?   @relation("TransferToAccount", fields: [ToAccountID], references: [ID])
  FromWarehouse Warehouse? @relation("TransferFromWarehouse", fields: [FromWarehouseID], references: [ID])
  ToWarehouse   Warehouse? @relation("TransferToWarehouse", fields: [ToWarehouseID], references: [ID])
  Status        TransactionStatus @relation(fields: [StatusID], references: [ID])

  @@map("Transfers")
}

// ═══════════════════════════════════════════════════════════════════════════════
// ASSET MANAGEMENT
// ═══════════════════════════════════════════════════════════════════════════════

// ─── AssetCategory ────────────────────────────────────────────
model AssetCategory {
  ID          Int      @id @default(autoincrement())
  Code        String   @unique @db.VarChar(50)
  Name        String   @db.VarChar(255)
  Description String?  @db.VarChar(1000)
  IsActive    Boolean  @default(true)
  CreatedAt   DateTime @default(now())
  UpdatedAt   DateTime @updatedAt

  Assets Asset[]

  @@map("AssetCategories")
}

// ─── Asset ─────────────────────────────────────────────────────
model Asset {
  ID                 Int                @id @default(autoincrement())
  Code               String             @unique @db.VarChar(50)
  Name               String             @db.VarChar(255)
  AssetCategoryID    Int?
  PurchaseDate       DateTime?
  PurchasePrice      Decimal            @default(0) @db.Decimal(15, 2)
  CurrentValue       Decimal            @default(0) @db.Decimal(15, 2)
  DepreciationMethodID Int?
  UsefulLifeYears    Int                @default(0)
  Location           String?            @db.VarChar(255)
  AssignedTo         String?            @db.VarChar(255)
  SerialNumber       String?            @db.VarChar(100)
  Description        String?            @db.VarChar(1000)
  StatusID           Int                @default(1)
  IsActive           Boolean            @default(true)
  CreatedAt          DateTime           @default(now())
  UpdatedAt          DateTime           @updatedAt

  Category          AssetCategory?       @relation(fields: [AssetCategoryID], references: [ID])
  DepreciationMethod DepreciationMethod? @relation(fields: [DepreciationMethodID], references: [ID])
  Status            AssetStatus         @relation(fields: [StatusID], references: [ID])

  @@map("Assets")
}

// ═══════════════════════════════════════════════════════════════════════════════
// SERVICE & REPAIR MANAGEMENT
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Service ───────────────────────────────────────────────────
model Service {
  ID               Int          @id @default(autoincrement())
  Code             String       @unique @db.VarChar(50)
  Date             DateTime     @default(now())
  CustomerID       Int?
  CustomerName     String?      @db.VarChar(255)
  CustomerPhone    String?      @db.VarChar(50)
  CustomerAddress  String?      @db.VarChar(500)
  ProductName      String?      @db.VarChar(255)
  SerialNumber     String?      @db.VarChar(100)
  Problem          String?      @db.VarChar(1000)
  Diagnosis        String?      @db.VarChar(1000)
  RepairStatusID  Int          @default(1)
  Technician      String?      @db.VarChar(255)
  WarrantyUntil    DateTime?
  Subtotal        Decimal      @default(0) @db.Decimal(15, 2)
  LaborCost       Decimal      @default(0) @db.Decimal(15, 2)
  TotalAmount     Decimal      @default(0) @db.Decimal(15, 2)
  Notes           String?      @db.VarChar(1000)
  IsActive        Boolean      @default(true)
  CreatedAt       DateTime    @default(now())
  UpdatedAt       DateTime    @updatedAt

  Customer   Customer?     @relation(fields: [CustomerID], references: [ID])
  Status    RepairStatus @relation(fields: [RepairStatusID], references: [ID])
  Items    ServiceItem[]

  @@map("Services")
}

// ─── ServiceItem ──────────────────────────────────────────────
model ServiceItem {
  ID          Int      @id @default(autoincrement())
  ServiceID   Int
  ProductID   Int?
  ProductName String   @db.VarChar(255)
  Quantity    Decimal  @db.Decimal(15, 3)
  UnitPrice   Decimal  @default(0) @db.Decimal(15, 2)
  Subtotal    Decimal  @default(0) @db.Decimal(15, 2)
  CreatedAt   DateTime @default(now())

  Service Service @relation(fields: [ServiceID], references: [ID], onDelete: Cascade)
  Product Product? @relation(fields: [ProductID], references: [ID])

  @@map("ServiceItems")
}

// ═══════════════════════════════════════════════════════════════════════════════
// PRICE HISTORY
// ═══════════════════════════════════════════════════════════════════════════════

model PriceHistory {
  ID         Int      @id @default(autoincrement())
  ProductID  Int
  Type       String   @db.VarChar(20)
  OldPrice   Decimal  @db.Decimal(15, 2)
  NewPrice   Decimal  @db.Decimal(15, 2)
  ChangedBy  String?  @db.VarChar(255)
  ChangedAt  DateTime @default(now())
  CreatedAt  DateTime @default(now())

  Product Product @relation(fields: [ProductID], references: [ID])

  @@map("PriceHistories")
}

// ─── ProductPrice (Tiered/Special Pricing) ──────────────────────────────────
model ProductPrice {
  ID          Int       @id @default(autoincrement())
  ProductID   Int
  UnitID      Int
  PriceType   String    @default("STANDARD") @db.VarChar(50)
  Price       Decimal   @db.Decimal(15, 2)
  MinQuantity Decimal?  @db.Decimal(15, 3)
  MaxQuantity Decimal?  @db.Decimal(15, 3)
  StartDate  DateTime?
  EndDate    DateTime?
  IsActive   Int       @default(1)
  CreatedAt  DateTime  @default(now())
  UpdatedAt  DateTime  @updatedAt

  Product Product @relation(fields: [ProductID], references: [ID], onDelete: Cascade)
  Unit    Unit    @relation(fields: [UnitID], references: [ID])

  @@unique([ProductID, UnitID, PriceType])
  @@map("ProductPrices")
}

// ═══════════════════════════════════════════════════════════════════════════════
// VOUCHER MANAGEMENT
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Voucher ─────────────────────────────────────────────────
model Voucher {
  ID                Int         @id @default(autoincrement())
  Code              String      @unique @db.VarChar(50)
  Name              String      @db.VarChar(255)
  TypeID            Int
  Value             Decimal     @db.Decimal(15, 2)
  MinPurchaseAmount Decimal     @default(0) @db.Decimal(15, 2)
  MaxDiscountAmount Decimal?    @db.Decimal(15, 2)
  StartDate         DateTime
  EndDate           DateTime
  UsageLimit        Int?
  UsedCount         Int         @default(0)
  IsActive          Boolean     @default(true)
  CreatedAt         DateTime    @default(now())
  UpdatedAt         DateTime    @updatedAt

  Type VoucherType @relation(fields: [TypeID], references: [ID])

  @@map("Vouchers")
}

// ─── Tax ──────────────────────────────────────────────────────
model Tax {
  ID          Int      @id @default(autoincrement())
  Code        String   @unique @db.VarChar(50)
  Name        String   @db.VarChar(255)
  Rate        Decimal  @db.Decimal(5, 2)
  Description String?  @db.VarChar(1000)
  IsActive    Boolean  @default(true)
  CreatedAt   DateTime @default(now())
  UpdatedAt   DateTime @updatedAt

  @@map("Taxes")
}

// ═══════════════════════════════════════════════════════════════════════════════
// PRODUCTION MANAGEMENT
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Production ───────────────────────────────────────────────
model Production {
  ID              Int               @id @default(autoincrement())
  Code            String            @unique @db.VarChar(50)
  Date            DateTime          @default(now())
  ProductID       Int?
  ProductName     String?           @db.VarChar(255)
  Quantity        Decimal           @default(0) @db.Decimal(15, 3)
  WarehouseID     Int?
  RawMaterialCost Decimal           @default(0) @db.Decimal(15, 2)
  LaborCost       Decimal           @default(0) @db.Decimal(15, 2)
  OverheadCost    Decimal           @default(0) @db.Decimal(15, 2)
  TotalCost       Decimal           @default(0) @db.Decimal(15, 2)
  StatusID        Int               @default(1)
  Notes           String?           @db.VarChar(1000)
  IsActive        Boolean           @default(true)
  CreatedAt       DateTime          @default(now())
  UpdatedAt       DateTime          @updatedAt

  Warehouse Warehouse?         @relation(fields: [WarehouseID], references: [ID])
  Product   Product?          @relation(fields: [ProductID], references: [ID])
  Status    ProductionStatus  @relation(fields: [StatusID], references: [ID])
  Items     ProductionItem[]
  WorkOrders WorkOrder[]
  DefectReports DefectReport[]
  QCInspections QCInspection[]

  @@map("Productions")
}

// ─── ProductionItem (BOM - Bill of Materials) ─────────────────
model ProductionItem {
  ID            Int      @id @default(autoincrement())
  ProductionID  Int
  ProductID     Int
  ProductName   String   @db.VarChar(255)
  Quantity      Decimal  @db.Decimal(15, 3)
  UnitID        Int?
  UnitPrice     Decimal  @default(0) @db.Decimal(15, 2)
  Subtotal      Decimal  @default(0) @db.Decimal(15, 2)
  CreatedAt     DateTime @default(now())

  Production Production @relation(fields: [ProductionID], references: [ID], onDelete: Cascade)
  Product    Product?   @relation(fields: [ProductID], references: [ID])
  Unit       Unit?      @relation(fields: [UnitID], references: [ID])

  @@map("ProductionItems")
}

// ═══════════════════════════════════════════════════════════════════════════════
// DASHBOARD & ANALYTICS
// ═══════════════════════════════════════════════════════════════════════════════

// ─── DailySalesSummary ────────────────────────────────────────
model DailySalesSummary {
  ID                Int      @id @default(autoincrement())
  Date              DateTime @db.Date
  TotalTransactions Int      @default(0)
  TotalCost         Decimal  @default(0) @db.Decimal(15, 2)
  TotalSales        Decimal  @default(0) @db.Decimal(15, 2)
  TotalProfit       Decimal  @default(0) @db.Decimal(15, 2)
  TotalReturns      Decimal  @default(0) @db.Decimal(15, 2)
  TotalExpenses     Decimal  @default(0) @db.Decimal(15, 2)
  CreatedAt         DateTime @default(now())
  UpdatedAt         DateTime @updatedAt

  @@unique([Date])
  @@map("DailySalesSummaries")
}

// ─── MonthlySalesSummary ──────────────────────────────────────
model MonthlySalesSummary {
  ID                Int      @id @default(autoincrement())
  Year              Int
  Month             Int
  TotalTransactions Int      @default(0)
  TotalCost         Decimal  @default(0) @db.Decimal(15, 2)
  TotalSales        Decimal  @default(0) @db.Decimal(15, 2)
  TotalProfit       Decimal  @default(0) @db.Decimal(15, 2)
  TotalReturns      Decimal  @default(0) @db.Decimal(15, 2)
  TotalExpenses     Decimal  @default(0) @db.Decimal(15, 2)
  CreatedAt         DateTime @default(now())
  UpdatedAt         DateTime @updatedAt

  @@unique([Year, Month])
  @@map("MonthlySalesSummaries")
}

// ─── ActivityLog ──────────────────────────────────────────────
model ActivityLog {
  ID           Int      @id @default(autoincrement())
  Type         String   @db.VarChar(50)
  Title        String   @db.VarChar(255)
  Description  String?  @db.VarChar(1000)
  ReferenceType String? @db.VarChar(100)
  ReferenceID   Int?
  Amount       Decimal? @db.Decimal(15, 2)
  CreatedByID  String?
  CreatedAt    DateTime @default(now())

  @@index([CreatedAt(sort: Desc)])
  @@map("ActivityLogs")
}

// ─── StockAlert ────────────────────────────────────────────────
model StockAlert {
  ID          Int       @id @default(autoincrement())
  ProductID   Int
  AlertTypeID Int
  Threshold   Decimal   @default(0) @db.Decimal(15, 3)
  CurrentStock Decimal  @default(0) @db.Decimal(15, 3)
  IsRead      Boolean   @default(false)
  IsResolved  Boolean   @default(false)
  ResolvedAt  DateTime?
  Notes       String?   @db.VarChar(1000)
  CreatedAt   DateTime  @default(now())
  UpdatedAt   DateTime  @updatedAt

  Product   Product   @relation(fields: [ProductID], references: [ID])
  AlertType AlertType @relation(fields: [AlertTypeID], references: [ID])

  @@index([IsRead, IsResolved])
  @@map("StockAlerts")
}

// ─── Budget ─────────────────────────────────────────────────────────────
model Budget {
  ID              Int      @id @default(autoincrement())
  Name            String   @db.VarChar(255)
  Type            String   @db.VarChar(50) // 'EXPENSE', 'REVENUE'
  CategoryID      Int?
  WarehouseID     Int?
  DepartmentID    Int?
  StartDate       DateTime
  EndDate         DateTime
  BudgetedAmount  Decimal  @db.Decimal(15, 2)
  IsActive        Boolean  @default(true)
  CreatedAt       DateTime @default(now())
  UpdatedAt       DateTime @updatedAt

  @@map("Budgets")
}

// ─── SalesTarget ───────────────────────────────────────────────────
model SalesTarget {
  ID              Int      @id @default(autoincrement())
  Name            String   @db.VarChar(255)
  Type            String   @db.VarChar(50) // 'REVENUE', 'QUANTITY'
  EmployeeID      Int?
  WarehouseID     Int?
  CategoryID      Int?
  StartDate       DateTime
  EndDate         DateTime
  TargetRevenue   Decimal  @default(0) @db.Decimal(15, 2)
  TargetQuantity  Decimal  @default(0) @db.Decimal(15, 3)
  IsActive        Boolean  @default(true)
