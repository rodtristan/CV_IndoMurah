}

model Testing {
  id        Int      @id @default(autoincrement())
  type      String   @unique @db.VarChar(100)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("testings")
}

// ═══════════════════════════════════════════════════════════════════════════════
// EXPENSE MANAGEMENT
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Expense Category ─────────────────────────────────────────
model ExpenseCategory {
  id          Int       @id @default(autoincrement())
  code        String    @unique @db.VarChar(50)
  name        String    @db.VarChar(255)
  description String?   @db.VarChar(1000)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  expenses Expense[]

  @@map("expense_categories")
}

// ─── Expense ───────────────────────────────────────────────────
model Expense {
  id              Int       @id @default(autoincrement())
  code            String    @unique @db.VarChar(50)
  date            DateTime  @default(now())
  expenseCategoryId Int
  amount          Decimal   @db.Decimal(15, 2)
  description     String?   @db.VarChar(1000)
  referenceNumber String?   @db.VarChar(100)
  isApproved      Boolean   @default(false)
  approvedById    String?
  approvedAt      DateTime?
  notes           String?   @db.VarChar(1000)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  expenseCategory ExpenseCategory @relation(fields: [expenseCategoryId], references: [id])
  approver       User?          @relation(fields: [approvedById], references: [id])

  @@map("expenses")
}

// ─── Transfer ──────────────────────────────────────────────────
model Transfer {
  id            Int               @id @default(autoincrement())
  code          String            @unique @db.VarChar(50)
  date          DateTime          @default(now())
  fromAccountId Int?
  toAccountId   Int?
  fromWarehouseId Int?
  toWarehouseId Int?
  amount        Decimal           @db.Decimal(15, 2)
  description   String?           @db.VarChar(1000)
  status        TransactionStatus @default(DRAFT)
  notes         String?           @db.VarChar(1000)
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  fromAccount   Account?   @relation("TransferFromAccount", fields: [fromAccountId], references: [id])
  toAccount     Account?   @relation("TransferToAccount", fields: [toAccountId], references: [id])
  fromWarehouse Warehouse? @relation("TransferFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse? @relation("TransferToWarehouse", fields: [toWarehouseId], references: [id])

  @@map("transfers")
}

// ═══════════════════════════════════════════════════════════════════════════════
// ASSET MANAGEMENT
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Asset Category ────────────────────────────────────────────
model AssetCategory {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(255)
  description String?  @db.VarChar(1000)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assets Asset[]

  @@map("asset_categories")
}

// ─── Asset ─────────────────────────────────────────────────────
model Asset {
  id                 Int                @id @default(autoincrement())
  code               String             @unique @db.VarChar(50)
  name               String             @db.VarChar(255)
  assetCategoryId    Int?
  purchaseDate       DateTime?
  purchasePrice      Decimal            @default(0) @db.Decimal(15, 2)
  currentValue       Decimal            @default(0) @db.Decimal(15, 2)
  depreciationMethodId Int?
  usefulLifeYears    Int                @default(0)
  location           String?            @db.VarChar(255)
  assignedTo         String?            @db.VarChar(255)
  serialNumber       String?            @db.VarChar(100)
  description        String?            @db.VarChar(1000)
  statusId           Int                @default(1)
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  category          AssetCategory?       @relation(fields: [assetCategoryId], references: [id])
  depreciationMethod DepreciationMethod? @relation(fields: [depreciationMethodId], references: [id])
  status            AssetStatus         @relation(fields: [statusId], references: [id])

  @@map("assets")
}

// ═══════════════════════════════════════════════════════════════════════════════
// SERVICE & REPAIR MANAGEMENT
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Service ───────────────────────────────────────────────────
model Service {
  id               Int          @id @default(autoincrement())
  code             String       @unique @db.VarChar(50)
  date             DateTime     @default(now())
  customerId       Int?
  customerName     String?      @db.VarChar(255)
  customerPhone    String?      @db.VarChar(50)
  customerAddress  String?      @db.VarChar(500)
  productName      String?      @db.VarChar(255)
  serialNumber     String?      @db.VarChar(100)
  problem          String?      @db.VarChar(1000)
  diagnosis        String?      @db.VarChar(1000)
  repairStatusId  Int          @default(1)
  technician      String?      @db.VarChar(255)
  warrantyUntil    DateTime?
  subtotal        Decimal      @default(0) @db.Decimal(15, 2)
  laborCost       Decimal      @default(0) @db.Decimal(15, 2)
  totalAmount     Decimal      @default(0) @db.Decimal(15, 2)
  notes           String?      @db.VarChar(1000)
  isActive        Boolean      @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  customer   Customer?     @relation(fields: [customerId], references: [id])
  status    RepairStatus @relation(fields: [repairStatusId], references: [id])
  items    ServiceItem[]

  @@map("services")
}

// ─── Service Item ──────────────────────────────────────────────
model ServiceItem {
  id          Int      @id @default(autoincrement())
  serviceId   Int
  productId   Int?
  productName String   @db.VarChar(255)
  quantity    Decimal  @db.Decimal(15, 3)
  unitPrice   Decimal  @default(0) @db.Decimal(15, 2)
  subtotal    Decimal  @default(0) @db.Decimal(15, 2)
  createdAt   DateTime @default(now())

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@map("service_items")
}

// ═══════════════════════════════════════════════════════════════════════════════
// PRICE HISTORY
// ═══════════════════════════════════════════════════════════════════════════════

model PriceHistory {
  id         Int      @id @default(autoincrement())
  productId  Int
  type       String   @db.VarChar(20) // PURCHASE, SELLING
  oldPrice   Decimal  @db.Decimal(15, 2)
  newPrice   Decimal  @db.Decimal(15, 2)
  changedBy  String?  @db.VarChar(255)
  changedAt  DateTime @default(now())
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@map("price_histories")
}

// ═══════════════════════════════════════════════════════════════════════════════
// VOUCHER MANAGEMENT
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Voucher ─────────────────────────────────────────────────
model Voucher {
  id                Int         @id @default(autoincrement())
  code              String      @unique @db.VarChar(50)
  name              String      @db.VarChar(255)
  typeId            Int
  value             Decimal     @db.Decimal(15, 2)
  minPurchaseAmount Decimal     @default(0) @db.Decimal(15, 2)
  maxDiscountAmount Decimal?    @db.Decimal(15, 2)
  startDate         DateTime
  endDate           DateTime
  usageLimit        Int?        // null = unlimited
  usedCount         Int         @default(0)
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  type VoucherType @relation(fields: [typeId], references: [id])

  @@map("vouchers")
}

// ─── Tax ──────────────────────────────────────────────────────
model Tax {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(255)
  rate        Decimal  @db.Decimal(5, 2)
  description String?  @db.VarChar(1000)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("taxes")
}

// ═══════════════════════════════════════════════════════════════════════════════
// PRODUCTION MANAGEMENT
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Production ───────────────────────────────────────────────
model Production {
  id              Int               @id @default(autoincrement())
  code            String            @unique @db.VarChar(50)
  date            DateTime          @default(now())
  productId       Int?
  productName     String?           @db.VarChar(255)
  quantity        Decimal           @default(0) @db.Decimal(15, 3)
  warehouseId     Int?
  rawMaterialCost Decimal           @default(0) @db.Decimal(15, 2)
  laborCost       Decimal           @default(0) @db.Decimal(15, 2)
  overheadCost    Decimal           @default(0) @db.Decimal(15, 2)
  totalCost       Decimal           @default(0) @db.Decimal(15, 2)
  statusId        Int               @default(1)
  notes           String?           @db.VarChar(1000)
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  warehouse Warehouse?        @relation(fields: [warehouseId], references: [id])
  product   Product?          @relation(fields: [productId], references: [id])
  status    ProductionStatus  @relation(fields: [statusId], references: [id])
  items     ProductionItem[]

  @@map("productions")
}

// ─── Production Item (BOM - Bill of Materials) ─────────────────
model ProductionItem {
  id            Int      @id @default(autoincrement())
  productionId  Int
  productId     Int
  productName   String   @db.VarChar(255)
  quantity      Decimal  @db.Decimal(15, 3)
  unitId        Int?
  unitPrice     Decimal  @default(0) @db.Decimal(15, 2)
  subtotal      Decimal  @default(0) @db.Decimal(15, 2)
  createdAt     DateTime @default(now())

  production Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  product    Product?   @relation(fields: [productId], references: [id])
  unit       Unit?      @relation(fields: [unitId], references: [id])

  @@map("production_items")
}

// ═══════════════════════════════════════════════════════════════════════════════
// DASHBOARD & ANALYTICS
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Daily Sales Summary ────────────────────────────────────────
model DailySalesSummary {
  id                Int      @id @default(autoincrement())
  date              DateTime @db.Date
  totalTransactions Int      @default(0)
  totalCost         Decimal  @default(0) @db.Decimal(15, 2)
  totalSales        Decimal  @default(0) @db.Decimal(15, 2)
  totalProfit       Decimal  @default(0) @db.Decimal(15, 2)
  totalReturns      Decimal  @default(0) @db.Decimal(15, 2)
  totalExpenses     Decimal  @default(0) @db.Decimal(15, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([date])
  @@map("daily_sales_summaries")
}

// ─── Monthly Sales Summary ──────────────────────────────────────
model MonthlySalesSummary {
  id                Int      @id @default(autoincrement())
  year              Int
  month             Int
  totalTransactions Int      @default(0)
  totalCost         Decimal  @default(0) @db.Decimal(15, 2)
  totalSales        Decimal  @default(0) @db.Decimal(15, 2)
  totalProfit       Decimal  @default(0) @db.Decimal(15, 2)
  totalReturns      Decimal  @default(0) @db.Decimal(15, 2)
  totalExpenses     Decimal  @default(0) @db.Decimal(15, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([year, month])
  @@map("monthly_sales_summaries")
}

// ─── Activity Log ──────────────────────────────────────────────
model ActivityLog {
  id           Int      @id @default(autoincrement())
  type         String   @db.VarChar(50) // SALE, PURCHASE, STOCK_IN, STOCK_OUT, PAYMENT, etc.
  title        String   @db.VarChar(255)
  description  String?  @db.VarChar(1000)
  referenceType String? @db.VarChar(100)
  referenceId   Int?
  amount       Decimal? @db.Decimal(15, 2)
  createdById  String?
  createdAt    DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@map("activity_logs")
}

// ─── Stock Alert ────────────────────────────────────────────────
model StockAlert {
  id          Int       @id @default(autoincrement())
  productId   Int
  alertTypeId Int
  threshold   Decimal   @default(0) @db.Decimal(15, 3)
  currentStock Decimal  @default(0) @db.Decimal(15, 3)
  isRead      Boolean   @default(false)
  isResolved  Boolean   @default(false)
  resolvedAt  DateTime?
  notes       String?   @db.VarChar(1000)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  product   Product   @relation(fields: [productId], references: [id])
  alertType AlertType @relation(fields: [alertTypeId], references: [id])

  @@index([isRead, isResolved])
  @@map("stock_alerts")
}

// ═══════════════════════════════════════════════════════════════════════════════
// PRODUCT ENHANCEMENTS
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Product Image ─────────────────────────────────────────────
model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  url       String   @db.VarChar(500)
  caption   String?  @db.VarChar(255)
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

// ─── Product Barcode ────────────────────────────────────────────
model ProductBarcode {
  id          Int      @id @default(autoincrement())
  productId   Int
  barcode     String   @db.VarChar(100)
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([barcode])
  @@map("product_barcodes")
}

// ─── Brand Logo ────────────────────────────────────────────────
model BrandLogo {
  id        Int      @id @default(autoincrement())
  brandId   Int?
  name      String   @db.VarChar(255)
  logoUrl   String   @db.VarChar(500)
  website   String?  @db.VarChar(255)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand Brand? @relation(fields: [brandId], references: [id])

  @@map("brand_logos")
}

// ─── Notification Setting ──────────────────────────────────────
model NotificationSetting {
  id              Int      @id @default(autoincrement())
  userId          String
  typeId          Int
  emailEnabled    Boolean  @default(false)
  pushEnabled     Boolean  @default(true)
  inAppEnabled    Boolean  @default(true)
  threshold       Decimal? @db.Decimal(15, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type  NotificationType @relation(fields: [typeId], references: [id])

  @@unique([userId, typeId])
  @@map("notification_settings")
}

// ═══════════════════════════════════════════════════════════════════════════════
// HRM - HUMAN RESOURCE MANAGEMENT
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Department ────────────────────────────────────────────────
model Department {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(255)
  description String?  @db.VarChar(1000)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees Employee[]

  @@map("departments")
}

// ─── Position ─────────────────────────────────────────────────
model Position {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(255)
  description String?  @db.VarChar(1000)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees Employee[]

  @@map("positions")
}

// ─── Employee ─────────────────────────────────────────────────
model Employee {
  id            Int            @id @default(autoincrement())
  code          String         @unique @db.VarChar(50)
  name          String         @db.VarChar(255)
  departmentId  Int?
  positionId    Int?
  joinDate      DateTime?
  endDate       DateTime?
  birthDate     DateTime?
  gender        String?        @db.VarChar(20)
  phone         String?        @db.VarChar(50)
  email         String?        @db.VarChar(255)
  address       String?        @db.VarChar(500)
  emergencyContact String?     @db.VarChar(255)
  emergencyPhone   String?     @db.VarChar(50)
  basicSalary   Decimal        @default(0) @db.Decimal(15, 2)
  statusId      Int            @default(1)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  department Department?  @relation(fields: [departmentId], references: [id])
  position   Position?     @relation(fields: [positionId], references: [id])
  status     EmployeeStatus @relation(fields: [statusId], references: [id])
  attendances Attendance[]
  payrolls   Payroll[]
  loans      Loan[]
  leaves     Leave[]
  leaveBalances LeaveBalance[]

  @@map("employees")
}

// ─── Attendance ───────────────────────────────────────────────
model Attendance {
  id         Int              @id @default(autoincrement())
  employeeId Int
  date       DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  statusId    Int              @default(1)
  notes      String?          @db.VarChar(1000)
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  employee Employee          @relation(fields: [employeeId], references: [id])
  status   AttendanceStatus @relation(fields: [statusId], references: [id])

  @@unique([employeeId, date])
  @@map("attendances")
}

// ─── Payroll ───────────────────────────────────────────────────
model Payroll {
  id           Int      @id @default(autoincrement())
  code         String   @unique @db.VarChar(50)
  employeeId   Int
  period       String   @db.VarChar(20) // e.g., "2024-01"
  basicSalary  Decimal  @db.Decimal(15, 2)
  allowances   Decimal  @default(0) @db.Decimal(15, 2)
  deductions   Decimal  @default(0) @db.Decimal(15, 2)
  overtimePay  Decimal  @default(0) @db.Decimal(15, 2)
  totalSalary  Decimal  @default(0) @db.Decimal(15, 2)
  paymentDate  DateTime?
  notes        String?  @db.VarChar(1000)
  isPaid       Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("payrolls")
}

// ─── Loan / Pinjaman ──────────────────────────────────────────
model Loan {
  id               Int        @id @default(autoincrement())
  code             String     @unique @db.VarChar(50)
  employeeId       Int
  loanTypeId       Int
  principalAmount  Decimal    @db.Decimal(15, 2)
  interestRate     Decimal    @default(0) @db.Decimal(5, 2)
  tenorMonths      Int        @default(1)
  installmentAmount Decimal   @db.Decimal(15, 2)
  totalAmount      Decimal    @db.Decimal(15, 2)
  remainingAmount  Decimal    @db.Decimal(15, 2)
  startDate        DateTime?
  statusId         Int        @default(1)
  notes            String?    @db.VarChar(1000)
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  employee Employee     @relation(fields: [employeeId], references: [id])
  loanType LoanType      @relation(fields: [loanTypeId], references: [id])
  status   LoanStatus    @relation(fields: [statusId], references: [id])
  installments LoanInstallment[]

  @@map("loans")
}

// ─── Loan Installment ─────────────────────────────────────────
model LoanInstallment {
  id            Int      @id @default(autoincrement())
  loanId        Int
  period        String   @db.VarChar(20) // e.g., "2024-01"
  amount        Decimal  @db.Decimal(15, 2)
  principal     Decimal  @db.Decimal(15, 2)
  interest      Decimal  @db.Decimal(15, 2)
  remainingBefore Decimal @db.Decimal(15, 2)
  remainingAfter  Decimal @db.Decimal(15, 2)
  paymentDate   DateTime?
  status        String   @default("UNPAID") @db.VarChar(20) // PAID, UNPAID
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  loan Loan @relation(fields: [loanId], references: [id])

  @@map("loan_installments")
}

// ═══════════════════════════════════════════════════════════════════════════════
// LEAVE MANAGEMENT (Cuti/Izin)
// ═══════════════════════════════════════════════════════════════════════════════

model Leave {
  id            Int         @id @default(autoincrement())
  code          String      @unique @db.VarChar(50)
  employeeId    Int
  typeId        Int
  startDate     DateTime
  endDate       DateTime
  totalDays     Int         @default(1)
  reason        String?     @db.VarChar(1000)
  statusId      Int         @default(1)
  approvedById  String?
  approvedAt    DateTime?
  rejectedReason String?    @db.VarChar(500)
  notes         String?     @db.VarChar(1000)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  employee Employee      @relation(fields: [employeeId], references: [id])
  type     LeaveType     @relation(fields: [typeId], references: [id])
  approver User?        @relation(fields: [approvedById], references: [id])
  status   LeaveStatus   @relation(fields: [statusId], references: [id])

  @@map("leaves")
}

// ─── Leave Balance (Sisa Cuti Karyawan) ─────────────────────
model LeaveBalance {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  year        Int
  typeId      Int
  totalDays   Int       @default(0)
  usedDays    Int       @default(0)
  remainingDays Int      @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employee Employee  @relation(fields: [employeeId], references: [id])
  type     LeaveType @relation(fields: [typeId], references: [id])

  @@unique([employeeId, year, typeId])
  @@map("leave_balances")
}

// ═══════════════════════════════════════════════════════════════════════════════
// NOTIFICATION
// ═══════════════════════════════════════════════════════════════════════════════

model Notification {
  id        Int                @id @default(autoincrement())
  userId    String?
  title     String            @db.VarChar(255)
  message   String            @db.VarChar(1000)
  typeId    Int                @default(1)
  isRead    Boolean           @default(false)
  referenceType String?       @db.VarChar(100)
  referenceId   Int?
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())

  user User?             @relation(fields: [userId], references: [id])
  type  NotificationType @relation(fields: [typeId], references: [id])

  @@map("notifications")
}

// ═══════════════════════════════════════════════════════════════════════════════
// APP SETTINGS (Pengaturan Umum / Transaksi / Desimal Digit — single-row config)
// ═══════════════════════════════════════════════════════════════════════════════

model AppSetting {
  id Int @id @default(autoincrement())

  // ── Tab Umum ──
  reportDesignEnabled Boolean @default(false)
  itemAddMode         String  @default("SEDANG") @db.VarChar(20) // MUDAH | SEDANG
  displayMode         String  @default("ACTIVE_ONLY") @db.VarChar(20) // ALL | ACTIVE_ONLY
  displayRowMode      String  @default("SINGLE_ROW") @db.VarChar(20) // PER_UNIT | SINGLE_ROW
  timezone            String  @default("Asia/Jakarta") @db.VarChar(50)
  maxSearchRows       Int     @default(100)
  addressBinding      String  @default("COMPANY") @db.VarChar(20) // WAREHOUSE | COMPANY

  // ── Tab Transaksi ──
  showImageOnTransaction     Boolean @default(true)
  warnPriceBelowCost         Boolean @default(true)
  showBrandColumn            Boolean @default(false)
