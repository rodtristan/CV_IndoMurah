# ───────────────────────────────────────────────────────────
# Toko CV IndoMurah API — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ───────────────────────────────────────────────────────────

# NODE_ENV = production | development | testing
NODE_ENV=development
NODE_HOST=localhost
NODE_PORT=5000
PORT=5000

# ─── Database Configuration ─────────────────────────────────

# Development
DB_DEV_HOST=localhost
DB_DEV_PORT=5432
DB_DEV_USER=postgres
DB_DEV_PASS=changeme
DB_DEV=toko_cv_indomurah_dev
DB_DEV_DIALECT=postgres

# Production
DB_PRD_HOST=localhost
DB_PRD_PORT=5432
DB_PRD_USER=postgres
DB_PRD_PASS=changeme
DB_PRD=toko_cv_indomurah_prod
DB_PRD_DIALECT=postgres

# Testing
DB_TEST_HOST=localhost
DB_TEST_PORT=5432
DB_TEST_USER=postgres
DB_TEST_PASS=changeme
DB_TEST=toko_cv_indomurah_test
DB_TEST_DIALECT=postgres

# Prisma Database URL — adjust to match NODE_ENV above
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Development:
DATABASE_URL="postgresql://postgres:changeme@localhost:5432/toko_cv_indomurah_dev?schema=public"
# Production:  DATABASE_URL="postgresql://postgres:changeme@localhost:5432/toko_cv_indomurah_prod?schema=public"
# Testing:     DATABASE_URL="postgresql://postgres:changeme@localhost:5432/toko_cv_indomurah_test?schema=public"
# Railway:     set DATABASE_URL as an environment variable on the Railway
#              service itself (dashboard -> Variables) — never commit the
#              real value here. Migrations run automatically on boot
#              (see Dockerfile: `prisma migrate deploy && node dist/main`).

# ─── JWT Configuration ──────────────────────────────────────
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=8h
EXPIRATION_TIME=8h
AUTH_SECRET_KEY=change-me-in-production

# ─── Redis ──────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=yourpassword   # uncomment if Redis requires auth
REDIS_TTL=300

# ─── Security ───────────────────────────────────────────────
# Salt used to hash IDs in URL params (change in production!)
HASH_ID_SALT=toko-cv-indomurah-default-salt-change-in-production
HASH_ID_MIN_LENGTH=8

# Argon2 tuning (defaults shown — usually fine to leave as-is)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# ─── CORS ───────────────────────────────────────────────────
# Comma-separate multiple origins. Mobile apps (shop/mobile) aren't
# browsers, so CORS doesn't apply to them — this only gates the dashboard.
# Production (Railway): CORS_ORIGIN=https://cvindomurah.vercel.app
CORS_ORIGIN=*

# Google Drive (storage gambar Report Design) - refresh token dari OAuth Playground, scope drive.file
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
GDRIVE_FOLDER_ID=
