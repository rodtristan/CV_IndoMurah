# ───────────────────────────────────────────────────────────
# Toko CV IndoMurah API — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ───────────────────────────────────────────────────────────

# NODE_ENV = production | development | testing
NODE_ENV=development
NODE_HOST=localhost
NODE_PORT=5000
PORT=5000

# ─── Database Configuration ─────────────────────────────────

# Development
DB_DEV_HOST=localhost
DB_DEV_PORT=5432
DB_DEV_USER=postgres
DB_DEV_PASS=changeme
DB_DEV=toko_cv_indomurah_dev
DB_DEV_DIALECT=postgres

# Production
DB_PRD_HOST=localhost
DB_PRD_PORT=5432
DB_PRD_USER=postgres
DB_PRD_PASS=changeme
DB_PRD=toko_cv_indomurah_prod
DB_PRD_DIALECT=postgres

# Testing
DB_TEST_HOST=localhost
DB_TEST_PORT=5432
DB_TEST_USER=postgres
DB_TEST_PASS=changeme
DB_TEST=toko_cv_indomurah_test
DB_TEST_DIALECT=postgres

# Prisma Database URL — adjust to match NODE_ENV above
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Development:
DATABASE_URL="postgresql://postgres:changeme@localhost:5432/toko_cv_indomurah_dev?schema=public"
# Production:  DATABASE_URL="postgresql://postgres:changeme@localhost:5432/toko_cv_indomurah_prod?schema=public"
# Testing:     DATABASE_URL="postgresql://postgres:changeme@localhost:5432/toko_cv_indomurah_test?schema=public"
# Railway:     set DATABASE_URL as an environment variable on the Railway
#              service itself (dashboard -> Variables) — never commit the
#              real value here. Migrations run automatically on boot
#              (see Dockerfile: `prisma migrate deploy && node dist/main`).

# ─── JWT Configuration ──────────────────────────────────────
# WAJIB di production: minimal 32 karakter acak — API menolak start bila kosong/pendek.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# (Development: boleh kosong, API memakai secret dev + peringatan.)
JWT_SECRET=
JWT_EXPIRES_IN=8h
EXPIRATION_TIME=8h
AUTH_SECRET_KEY=change-me-in-production

# ─── Redis ──────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=yourpassword   # uncomment if Redis requires auth
REDIS_TTL=300

# ─── Security ───────────────────────────────────────────────
# Salt used to hash IDs in URL params (change in production!)
HASH_ID_SALT=toko-cv-indomurah-default-salt-change-in-production
HASH_ID_MIN_LENGTH=8

# Argon2 tuning (defaults shown — usually fine to leave as-is)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# ─── CORS ───────────────────────────────────────────────────
# Comma-separate multiple origins. Mobile apps (shop/mobile) aren't
# browsers, so CORS doesn't apply to them — this only gates the dashboard.
# Production (Railway): CORS_ORIGIN=https://cvindomurah.vercel.app
# WAJIB di production (daftar origin eksplisit, bukan "*"); API menolak start bila kosong.
# Development: kosong = semua origin diizinkan (tanpa credentials).
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ─── Proxy ──────────────────────────────────────────────────
# Di belakang proxy (Railway/Docker/Nginx) req.ip diambil dari X-Forwarded-For
# supaya rate-limit per IP klien asli. true (default) | false | jumlah hop | daftar IP.
TRUST_PROXY=true

# ─── Seed ───────────────────────────────────────────────────
# Password admin awal untuk `npx prisma db seed`. Wajib (min 8 karakter) saat
# NODE_ENV=production; di development default admin123.
SEED_ADMIN_PASSWORD=

# Google Drive (storage gambar Report Design) - refresh token dari OAuth Playground, scope drive (penuh, wajib bila memakai GDRIVE_FOLDER_ID)
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
GDRIVE_FOLDER_ID=

# ─── Web Push (notifikasi HP/desktop) ───
# Buat dengan: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
