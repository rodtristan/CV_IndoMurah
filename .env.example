# ───────────────────────────────────────────────────────────
# Toko CV IndoMurah — Docker Compose Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ───────────────────────────────────────────────────────────

# ─── Postgres (indomurah-postgres) ──────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=toko_cv_indomurah_prod
POSTGRES_PORT=5432

# ─── Redis (indomurah-redis) ────────────────────────────────
REDIS_PORT=6379

# ─── API (indomurah-api) ────────────────────────────────────
API_PORT=5000
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=8h
EXPIRATION_TIME=8h
AUTH_SECRET_KEY=change-me-in-production
HASH_ID_SALT=toko-cv-indomurah-default-salt-change-in-production
HASH_ID_MIN_LENGTH=8
CORS_ORIGIN=*

# ─── Dashboard (indomurah-dashboard) — Nuxt, folder `dashboard/` ──
DASHBOARD_PORT=3000
DASHBOARD_PUBLIC_URL=http://localhost:3000

# ─── Dashboard (indomurah-dashboard-next) — Next.js rewrite, folder `website/` ──
DASHBOARD_NEXT_PORT=3001

# ─── Ecommerce (indomurah-ecommerce) — Flutter Web ──────────
ECOMMERCE_PORT=8081

# ─── HR / Absensi (indomurah-hr) — Flutter Web ──────────────
HR_PORT=8082

# ─── APK builder output ──────────────────────────────────────
# Host folder where `shop-apk-builder` / `mobile-apk-builder`
# copy the built .apk files to (see README for usage).
APK_OUTPUT_DIR=C:/Temp

# ─── Flutter backend URL (baked in at build time via --dart-define) ──
# API_BASE_URL         — used by the `shop`/`mobile` web-preview services
#                        (nginx, viewed in Chrome). Keep pointed at the
#                        local api service unless you want to preview
#                        against production.
# API_BASE_URL_RELEASE — used by `shop-apk-builder`/`mobile-apk-builder`
#                        (real APKs meant for actual devices/distribution).
#                        Defaults to the production Railway API below.
API_BASE_URL=http://localhost:5000/api/v1
API_BASE_URL_RELEASE=https://cvindomurah.up.railway.app/api/v1
